#!/usr/bin/env python3
"""Deprecated wrapper — use `ytm-sync fix-covers` instead."""
import sys, subprocess
from pathlib import Path
print("warning: cropCoverImage is deprecated — use `ytm-sync fix-covers` instead.", file=sys.stderr)
if len(sys.argv) > 1 and Path(sys.argv[1]).is_dir():
    print(f"note: cropCoverImage used to scan arbitrary directories; ytm-sync fix-covers now scans your library at the path in ~/.config/ytm-sync/config.toml", file=sys.stderr)
    print(f"      to scan '{sys.argv[1]}' set your music dir temporarily or move files there.", file=sys.stderr)
ytm = Path(__file__).with_name("ytm-sync")
sys.exit(subprocess.call([str(ytm), "fix-covers"]))
