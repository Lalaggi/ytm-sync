#!/usr/bin/env python3
"""
fix_cover_art.py - Recursively scan a directory for audio files,
check embedded cover art aspect ratio, and crop to 1:1 (center) if needed.

Supports: MP3, FLAC, OGG, OPUS, M4A, AAC, WAV, AIFF

Dependencies:
    pip install mutagen Pillow
"""

import sys
import os
import io
import argparse
from pathlib import Path
from PIL import Image

try:
    from mutagen.mp3 import MP3
    from mutagen.id3 import ID3, APIC, ID3NoHeaderError
    from mutagen.flac import FLAC, Picture
    from mutagen.mp4 import MP4, MP4Cover
    from mutagen.aiff import AIFF
    import mutagen
except ImportError:
    print("Error: mutagen is required. Install with: pip install mutagen Pillow")
    sys.exit(1)


AUDIO_EXTENSIONS = {'.mp3', '.flac', '.ogg', '.opus', '.m4a', '.aac', '.wav', '.aiff', '.aif'}


def crop_to_square(image_bytes: bytes) -> bytes | None:
    """
    Given raw image bytes, check if it's 1:1. If not, crop to center square.
    Returns new image bytes if cropped, or None if already square.
    """
    img = Image.open(io.BytesIO(image_bytes))
    w, h = img.size

    if w == h:
        return None  # Already square

    size = min(w, h)
    left = (w - size) // 2
    top = (h - size) // 2
    right = left + size
    bottom = top + size

    cropped = img.crop((left, top, right, bottom))

    # Preserve original format if possible
    fmt = img.format or 'JPEG'
    out = io.BytesIO()
    cropped.save(out, format=fmt)
    return out.getvalue()


def fix_mp3(path: Path, dry_run: bool) -> bool:
    try:
        tags = ID3(path)
    except ID3NoHeaderError:
        return False

    changed = False
    for key in list(tags.keys()):
        if key.startswith('APIC'):
            apic = tags[key]
            new_data = crop_to_square(apic.data)
            if new_data:
                print(f"  [MP3] Cropping cover: {path}")
                if not dry_run:
                    apic.data = new_data
                    tags.save(path)
                changed = True
                break  # Usually only one cover
    return changed


def fix_flac(path: Path, dry_run: bool) -> bool:
    audio = FLAC(path)
    changed = False
    for pic in audio.pictures:
        if pic.type == 3:  # Front cover
            new_data = crop_to_square(pic.data)
            if new_data:
                print(f"  [FLAC] Cropping cover: {path}")
                if not dry_run:
                    pic.data = new_data
                    audio.save()
                changed = True
                break
    return changed


def fix_ogg_any(path: Path, dry_run: bool) -> bool:
    """
    Use mutagen's generic File() to auto-detect the actual OGG stream type
    (Vorbis, Opus, Speex, etc.) rather than guessing from extension.
    YTM downloads are often Opus streams with a .ogg extension.
    """
    audio = mutagen.File(path)
    if audio is None:
        raise ValueError("mutagen could not identify file")
    return _fix_ogg_picture(audio, path, dry_run, type(audio).__name__)


def _fix_ogg_picture(audio, path: Path, dry_run: bool, fmt: str) -> bool:
    import base64
    changed = False
    pictures = audio.get('metadata_block_picture', [])
    new_pictures = []
    for b64 in pictures:
        pic = Picture(base64.b64decode(b64))
        if pic.type == 3:
            new_data = crop_to_square(pic.data)
            if new_data:
                print(f"  [{fmt}] Cropping cover: {path}")
                if not dry_run:
                    pic.data = new_data
                    new_pictures.append(base64.b64encode(pic.write()).decode('ascii'))
                else:
                    new_pictures.append(b64)
                changed = True
                continue
        new_pictures.append(b64)

    if changed and not dry_run:
        audio['metadata_block_picture'] = new_pictures
        audio.save()
    return changed


def fix_m4a(path: Path, dry_run: bool) -> bool:
    audio = MP4(path)
    covers = audio.tags.get('covr', [])
    changed = False
    new_covers = []
    for cover in covers:
        new_data = crop_to_square(bytes(cover))
        if new_data:
            print(f"  [M4A] Cropping cover: {path}")
            fmt = MP4Cover.FORMAT_JPEG if cover.imageformat == MP4Cover.FORMAT_JPEG else MP4Cover.FORMAT_PNG
            new_covers.append(MP4Cover(new_data, imageformat=fmt))
            changed = True
        else:
            new_covers.append(cover)

    if changed and not dry_run:
        audio.tags['covr'] = new_covers
        audio.save()
    return changed


def fix_aiff(path: Path, dry_run: bool) -> bool:
    audio = AIFF(path)
    if audio.tags is None:
        return False
    changed = False
    for key in list(audio.tags.keys()):
        if key.startswith('APIC'):
            apic = audio.tags[key]
            new_data = crop_to_square(apic.data)
            if new_data:
                print(f"  [AIFF] Cropping cover: {path}")
                if not dry_run:
                    apic.data = new_data
                    audio.save()
                changed = True
                break
    return changed


HANDLERS = {
    '.mp3':  fix_mp3,
    '.flac': fix_flac,
    '.ogg':  fix_ogg_any,
    '.opus': fix_ogg_any,
    '.m4a':  fix_m4a,
    '.aac':  fix_m4a,
    '.aiff': fix_aiff,
    '.aif':  fix_aiff,
}


def scan_and_fix(directory: Path, dry_run: bool) -> None:
    fixed = 0
    skipped = 0
    no_cover = 0
    errors = 0

    audio_files = [
        f for f in directory.rglob('*')
        if f.is_file() and f.suffix.lower() in AUDIO_EXTENSIONS
    ]

    print(f"Found {len(audio_files)} audio file(s) in '{directory}'\n")

    for path in sorted(audio_files):
        ext = path.suffix.lower()
        handler = HANDLERS.get(ext)
        if handler is None:
            skipped += 1
            continue
        try:
            result = handler(path, dry_run)
            if result:
                fixed += 1
            else:
                no_cover += 1
        except Exception as e:
            print(f"  [ERROR] {path}: {e}")
            errors += 1

    print(f"\nDone.")
    print(f"  Cropped : {fixed}")
    print(f"  Already square / no cover: {no_cover}")
    print(f"  Errors  : {errors}")
    if dry_run:
        print("  (Dry-run mode — no files were modified)")


def main():
    parser = argparse.ArgumentParser(
        description="Crop non-square embedded cover art to 1:1 center crop."
    )
    parser.add_argument(
        'directory',
        nargs='?',
        default='.',
        help="Directory to scan (default: current directory)"
    )
    parser.add_argument(
        '--dry-run', '-n',
        action='store_true',
        help="Report what would be changed without modifying files"
    )
    args = parser.parse_args()

    directory = Path(args.directory).resolve()
    if not directory.is_dir():
        print(f"Error: '{directory}' is not a directory.")
        sys.exit(1)

    scan_and_fix(directory, dry_run=args.dry_run)


if __name__ == '__main__':
    main()
