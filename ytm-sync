def crop_cover_art(filepath: Path) -> bool:
    """Crop embedded cover art to a 1:1 square. Returns True if the file was modified."""
    try:
        from PIL import Image
        import io
    except ImportError:
        return False

    ext = filepath.suffix.lower()

    try:
        if ext in (".ogg", ".opus"):
            import base64
            import mutagen
            from mutagen.flac import Picture

            audio = mutagen.File(str(filepath))
            if audio is None:
                return False

            pictures = audio.get("metadata_block_picture", [])
            new_pics, changed = [], False
            for b64 in pictures:
                pic = Picture(base64.b64decode(b64))
                if pic.type == 3:
                    img  = Image.open(io.BytesIO(pic.data))
                    w, h = img.size
                    if w != h:
                        size = min(w, h)
                        left = (w - size) // 2
                        top  = (h - size) // 2
                        out  = io.BytesIO()
                        img.crop((left, top, left + size, top + size)).save(out, format="PNG")
                        pic.data = out.getvalue()
                        changed  = True
                new_pics.append(base64.b64encode(pic.write()).decode("ascii"))
            if changed:
                audio["metadata_block_picture"] = new_pics
                audio.save()
            return changed

        elif ext == ".m4a":
            from mutagen.mp4 import MP4, MP4Cover
            audio  = MP4(str(filepath))
            covers = audio.tags.get("covr", [])
            if not covers:
                return False

            new_covers, changed = [], False
            for cover in covers:
                img  = Image.open(io.BytesIO(bytes(cover)))
                w, h = img.size
                if w == h:
                    new_covers.append(cover)
                    continue
                size = min(w, h)
                left = (w - size) // 2
                top  = (h - size) // 2
                out  = io.BytesIO()
                fmt  = "PNG" if cover.imageformat == MP4Cover.FORMAT_PNG else "JPEG"
                img.crop((left, top, left + size, top + size)).save(out, format=fmt)
                new_fmt = MP4Cover.FORMAT_PNG if fmt == "PNG" else MP4Cover.FORMAT_JPEG
                new_covers.append(MP4Cover(out.getvalue(), imageformat=new_fmt))
                changed = True

            if changed:
                audio.tags["covr"] = new_covers
                audio.save()
            return changed

        elif ext == ".flac":
            from mutagen.flac import FLAC
            audio, changed = FLAC(str(filepath)), False
            for pic in audio.pictures:
                if pic.type != 3:
                    continue
                img  = Image.open(io.BytesIO(pic.data))
                w, h = img.size
                if w == h:
                    continue
                size = min(w, h)
                left = (w - size) // 2
                top  = (h - size) // 2
                out  = io.BytesIO()
                img.crop((left, top, left + size, top + size)).save(out, format="JPEG")
                pic.data = out.getvalue()
                changed  = True
            if changed:
                audio.save()
            return changed

        elif ext == ".mp3":
            from mutagen.id3 import ID3, APIC, ID3NoHeaderError
            try:
                tags = ID3(str(filepath))
            except ID3NoHeaderError:
                return False
            changed = False
            for key in list(tags.keys()):
                if key.startswith("APIC"):
                    apic = tags[key]
                    img = Image.open(io.BytesIO(apic.data))
                    w, h = img.size
                    if w == h:
                        continue
                    size = min(w, h)
                    left = (w - size) // 2
                    top = (h - size) // 2
                    out = io.BytesIO()
                    fmt = img.format or "JPEG"
                    img.crop((left, top, left + size, top + size)).save(out, format=fmt)
                    apic.data = out.getvalue()
                    changed = True
                    break
            if changed:
                tags.save(str(filepath))
            return changed

        elif ext in (".aiff", ".aif", ".wav"):
            from mutagen.aiff import AIFF
            try:
                audio = AIFF(str(filepath))
            except Exception:
                return False
            if audio.tags is None:
                return False
            changed = False
            for key in list(audio.tags.keys()):
                if key.startswith("APIC"):
                    apic = audio.tags[key]
                    img = Image.open(io.BytesIO(apic.data))
                    w, h = img.size
                    if w == h:
                        continue
                    size = min(w, h)
                    left = (w - size) // 2
                    top = (h - size) // 2
                    out = io.BytesIO()
                    fmt = img.format or "JPEG"
                    img.crop((left, top, left + size, top + size)).save(out, format=fmt)
                    apic.data = out.getvalue()
                    changed = True
                    break
            if changed:
                audio.save()
            return changed

    except Exception as e:
        print(f"    crop_cover_art warning: {filepath.name}: {e}")

    return False


