# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

SAFE_ASCII = set(",. -_'!()&+#:;?")

# Strip edition suffixes like (Deluxe), (Super Deluxe) etc. from album names
EDITION_RE = re.compile(r"\s*\([^)]*\b[Dd]eluxe\b[^)]*\)", re.IGNORECASE)

# Sanitize needs to avoid path traversal: a name that sanitizes to "." or
# ".." would escape the music directory when used as a Path component.
_SANITIZE_TRAVERSAL = {".", "..", ""}

def normalize_album(name: str) -> str:
    """Remove edition suffixes like (Deluxe) to avoid duplicate folders.

    Previous versions collapsed case/punctuation (e.g. "Album!" == "album"),
    which merged genuinely different releases. Now we only strip the
    edition suffix and whitespace — the filesystem still gets a sanitized
    name, but "Album!" and "album" stay distinct.
    """
    if not name:
        return ""
    name = EDITION_RE.sub("", name).strip()
    return name.strip() or name


def song_key(artist: str, title: str, album_id: str | None = None) -> str:
    """Stable identity for a SONG that survives album renames / re-releases.

    YTM often "upgrades" a saved track — e.g. swapping a single for the
    album version — which gives it a NEW video_id and often a new album_id.
    Previous code pinned the identity to album_id, so those upgrades looked
    like different songs and got re-downloaded. We now key purely on
    (artist, title) so a re-released version is recognised as the same song
    and handled in-place (update stored id/metadata, merge playlists) instead
    of being re-downloaded.

    `album_id` is kept as an accepted parameter for backwards compatibility
    but ignored — callers should just pass artist + title.
    """
    return f"{sanitize(artist).lower()} - {sanitize(title).lower()}"


def pl_list(entry: dict) -> list[str]:
    """Return a track entry's playlist memberships as a list of names.

    content.toml stores ONE entry per song with a `playlists` array. This
    normalises legacy entries that used a single comma-separated `playlist`
    string, a list, or nothing, into a clean list.
    """
    raw = entry.get("playlists")
    if raw is None:
        raw = entry.get("playlist", "")
    if isinstance(raw, str):
        return [p.strip() for p in raw.split(",") if p.strip()]
    if isinstance(raw, (list, tuple)):
        return [str(p).strip() for p in raw if str(p).strip()]
    return []


def add_playlist(entry: dict, name: str) -> None:
    """Add `name` to a track entry's `playlists` list (idempotent)."""
    pls = pl_list(entry)
    if name and name not in pls:
        pls.append(name)
    entry["playlists"] = pls


def sanitize(name: str) -> str:
    """Replace filesystem-unsafe characters in a name.
    Preserves alphanumerics, Unicode, and a small set of safe ASCII symbols.
    Guards against path traversal: results like "." / ".." are replaced with
    "_" and any path separator is escaped."""
    # Fast path: replace unsafe chars; "/" and "\\" are not in SAFE_ASCII nor
    # alnum, so they become "_", preventing absolute or traversal components.
    raw = "".join(
        c if c.isalnum() or c in SAFE_ASCII or ord(c) >= 128 else "_"
        for c in name
    ).strip(" _")
    if not raw or raw in _SANITIZE_TRAVERSAL:
        return "_"
    # Collapse any remaining traversal attempts like "..." or "./ ../"
    # and strip leading dots that could create hidden files.
    # If the result still looks like a traversal component, fall back to "_".
    if raw in _SANITIZE_TRAVERSAL or raw.startswith("."):
        # Keep single leading dot for things like "Dr. Dre" — that's fine,
        # but a component that is *only* dots is traversal.
        if set(raw) <= {"."}:
            return "_"
    return raw or "_"


def rel_path(full: Path, music_dir: Path) -> str:
    """Return a music_dir-relative path string for storage in content.toml."""
    try:
        return str(full.relative_to(music_dir))
    except ValueError:
        return str(full)


def expand_path(p: str, music_dir: Path) -> Path:
    """Expand a stored path to a full Path.
    Handles old ~-relative paths and new music_dir-relative paths."""
    if p.startswith("~/"):
        return Path(p.replace("~", str(Path.home())))
    if p.startswith("/"):
        return Path(p)
    return (music_dir / p).resolve()


def make_track_entry(track: dict, music_dir: Path) -> dict:
    """Build a content.toml entry dict from a YTM track dict."""
    safe_artist = sanitize(track["artist"])
    safe_title  = sanitize(track["title"])
    safe_album  = sanitize(normalize_album(track.get("album") or "Unknown Album"))
    full = music_dir / safe_artist / safe_album / f"{safe_artist} - {safe_title}.ogg"
    playlists = [track["playlist"]] if track.get("playlist") else []
    return {
        "youtube_id": track["video_id"],
        "path":       rel_path(full, music_dir),
        "name":       track["title"],
        "artist":     track["artist"],
        "album":      track.get("album", ""),
        "album_id":   track.get("album_id", ""),
        "playlists":  playlists,
    }


def write_content_toml(music_dir: Path, local_tracks: dict[str, list[dict]]) -> None:
    all_tracks = [entry for entries in local_tracks.values() for entry in entries]
    content_file = music_dir / "content.toml"
    with open(content_file, "w") as f:
        f.write("# YTM-Sync Content Library\n"
                "# Entries carry an 'album_id' (YTM album browseId) used to recognise\n"
                "# re-released versions of the same song so they aren't re-downloaded.\n\n")
        f.write(toml.dumps({"tracks": all_tracks}))
    print(f"  Updated {content_file}")


def write_playlists(music_dir: Path, tracks: list[dict]) -> None:
    """Write .m3u8 playlist files (relative paths) for all playlists in a track list."""
    playlists: dict[str, list[Path]] = {}
    for track in tracks:
        path = track.get("path", "")
        for pl in pl_list(track):
            if path and pl and pl != "__GET__":
                playlists.setdefault(pl, []).append(expand_path(path, music_dir))

    for playlist, track_paths in playlists.items():
        seen: set[str] = set()
        valid: list[Path] = []
        for p in track_paths:
            p_str = str(p)
            if p_str not in seen and p.exists():
                seen.add(p_str)
                valid.append(p)
        if not valid:
            continue
        safe_pl  = sanitize(playlist)
        pl_dir   = music_dir / safe_pl
        pl_dir.mkdir(parents=True, exist_ok=True)
        m3u_path = pl_dir / f"{safe_pl}.m3u8"
        valid.sort(key=str)
        with open(m3u_path, "w") as f:
            f.write("#EXTM3U\n")
            for p in valid:
                f.write(f"{os.path.relpath(p, pl_dir)}\n")
        print(f"  Written {m3u_path.name} ({len(valid)} tracks)")


