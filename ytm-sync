def _normalize_json_like_headers(raw: str) -> str | None:
    """Parse headers in JSON-object form: "key": "value"."""
    lines = []
    for line in raw.split("\n"):
        m = re.match(r'"([^"]+)"\s*:\s*"(.*)"', line.strip())
        if m:
            lines.append(f"{m.group(1)}: {m.group(2)}")
    return "\n".join(lines) if lines else None


def _normalize_raw_headers(raw: str) -> str:
    """Normalize raw request headers into Name: Value format."""
    PSEUDO = {":authority", ":method", ":path", ":scheme", ":status"}

    # Terminal escape-sequence alternating format
    if any(sep in raw for sep in ("^[E", "\x1bE", "\x1b")):
        sep = "^[E" if "^[E" in raw else ("\x1bE" if "\x1bE" in raw else "\x1b")
        parts = raw.split(sep)
        lines = []
        for i in range(0, len(parts) - 1, 2):
            name, value = parts[i].strip(), parts[i + 1].strip()
            if name and name not in PSEUDO:
                lines.append(f"{name}: {value}")
        return "\n".join(lines)

    raw_lines = [l for l in raw.split("\n") if l.strip()]
    colon_ratio = sum(1 for l in raw_lines if ": " in l) / max(len(raw_lines), 1)

    # Alternating name / value lines (no colons)
    if len(raw_lines) > 2 and colon_ratio < 0.2:
        lines = []
        for i in range(0, len(raw_lines) - 1, 2):
            name, value = raw_lines[i].strip(), raw_lines[i + 1].strip()
            if name not in PSEUDO:
                lines.append(f"{name}: {value}")
        return "\n".join(lines)

    # Standard colon-separated, just strip pseudo-headers
    return "\n".join(l.strip() for l in raw_lines if not l.strip().startswith(":"))


def _setup_from_cookies(cookie_str: str) -> bool:
    try:
        sapisid = sapisid_from_cookie(cookie_str)
    except Exception:
        print("  SAPISID cookie not found.")
        return False

    headers = dict(initialize_headers())
    headers["cookie"] = cookie_str
    headers["x-goog-authuser"] = "0"
    headers["authorization"] = get_authorization(f"{sapisid} https://music.youtube.com")

    AUTH_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(AUTH_FILE, "w") as f:
        json.dump(headers, f, ensure_ascii=True, indent=4, sort_keys=True)

    print("  Auth configured from cookies.")
    return validate_auth()


def setup_auth(download_path: str | None = None) -> bool:
    """Interactive auth setup — paste JSON cookies or raw request headers."""
    print("=" * 60)
    print("  YTM-Sync Authentication Setup")
    print("=" * 60)
    print()

    if download_path:
        music_dir = Path(download_path).expanduser()
    else:
        print("  Download path (default: ~/Music):")
        entered = input("  > ").strip()
        music_dir = Path(entered).expanduser() if entered else DEFAULT_MUSIC_DIR

    if not validate_download_path(music_dir):
        return False

    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        toml.dump({"download_path": str(music_dir)}, f)

    print(f"  Download path: {music_dir}")
    print(f"  Config saved to {CONFIG_FILE}")
    print()
    print("  Paste cookies as JSON (DevTools > Application > Cookies > Export)")
    print("  or paste raw request headers. Press Enter on an empty line when done:")
    print()

    lines = []
    while True:
        try:
            line = input()
            if not line:
                break
            lines.append(line)
        except EOFError:
            break

    raw = "\n".join(lines).strip()
    if not raw:
        print("  No input provided.")
        return False

    # JSON cookies
    try:
        data = json.loads(raw)
        if isinstance(data, dict):
            cookies = data.get("Request Cookies", data)
            cookie_str = "; ".join(f"{k}={v}" for k, v in cookies.items())
            print("  Detected JSON cookies format.")
            return _setup_from_cookies(cookie_str)
    except (json.JSONDecodeError, ValueError):
        pass

    # Raw / escaped headers
    normalized = _normalize_raw_headers(raw)
    if "cookie" not in normalized.lower():
        alt = _normalize_json_like_headers(raw)
        if alt and "cookie" in alt.lower():
            normalized = alt

    if "cookie" not in normalized.lower():
        print("  Error: No cookie/header data detected.")
        return False

    AUTH_FILE.parent.mkdir(parents=True, exist_ok=True)
    import ytmusicapi
    try:
        ytmusicapi.setup(filepath=str(AUTH_FILE), headers_raw=normalized)
        print(f"  Auth file configured at {AUTH_FILE}")
    except Exception as e:
        print(f"  Failed to setup auth: {e}")
        return False

    return validate_auth()


def validate_auth() -> bool:
    if not AUTH_FILE.exists():
        print("  No auth file found. Run 'ytm-sync setup' first.")
        return False

    try:
        ytm = YTMusic(str(AUTH_FILE))
        raw_response = None
        orig_post = ytm._session.post

        def _capture(url, *args, **kwargs):
            resp = orig_post(url, *args, **kwargs)
            if resp.status_code == 200 and "browse" in str(url):
                nonlocal raw_response
                raw_response = resp.json()
            return resp

        ytm._session.post = _capture
        try:
            ytm.get_library_playlists(limit=1)
        finally:
            ytm._session.post = orig_post

        if raw_response:
            for stp in raw_response.get("responseContext", {}).get("serviceTrackingParams", []):
                for param in stp.get("params", []):
                    if param.get("key") == "logged_in" and param.get("value") == "0":
                        print("  Auth validation failed: not logged in.")
                        return False

        print("  Authentication successful!")
        return True
    except Exception as e:
        print(f"  Auth validation failed: {e}")
        return False


def get_ytmusic_client() -> YTMusic:
    if not AUTH_FILE.exists():
        raise RuntimeError("Not authenticated. Run 'ytm-sync setup' first.")
    return YTMusic(str(AUTH_FILE))


def write_cookie_file() -> Path | None:
    """Write a Netscape cookie file from auth.txt for yt-dlp --cookies."""
    if not AUTH_FILE.exists():
        return None
    try:
        with open(AUTH_FILE) as f:
            headers = json.load(f)
        cookie_str = headers.get("cookie", "")
        if not cookie_str:
            return None
        lines = ["# Netscape HTTP Cookie File"]
        for part in cookie_str.split(";"):
            part = part.strip()
            if "=" not in part:
                continue
            name, value = part.split("=", 1)
            lines.append(f".youtube.com\tTRUE\t/\tTRUE\t\t{name}\t{value}")
        COOKIE_FILE.parent.mkdir(parents=True, exist_ok=True)
        COOKIE_FILE.write_text("\n".join(lines) + "\n")
        return COOKIE_FILE
    except Exception as e:
        print(f"  Warning: Could not write cookie file: {e}")
        return None


# ---------------------------------------------------------------------------
# Library data
# ---------------------------------------------------------------------------

def load_content_toml(music_dir: Path) -> dict:
    content_file = music_dir / "content.toml"
    if not content_file.exists():
        return {"tracks": []}
    with open(content_file) as f:
        return toml.load(f)


def get_local_tracks(content: dict) -> dict[str, list[dict]]:
    """Build {video_id: [entries]} from content.toml.

    Also attaches a `song_index` mapping each stable song_key() to the list
    of entries that belong to that song, so callers can detect when YTM has
    repointed a playlist entry at a re-released version of a song we already
    have (same artist/title, different video_id/album).
    """
    local: dict[str, list[dict]] = {}
    for track in content.get("tracks", []):
        vid = track.get("youtube_id")
        if vid:
            local.setdefault(vid, []).append(track)
    return local


def build_song_index(local_tracks: dict[str, list[dict]]) -> dict[str, list[dict]]:
    """Map song_key() -> [entries] across all local tracks."""
    index: dict[str, list[dict]] = {}
    for entries in local_tracks.values():
        for entry in entries:
            key = song_key(
                entry.get("artist", ""),
                entry.get("name", ""),
                entry.get("album_id", ""),
            )
            index.setdefault(key, []).append(entry)
    return index


def reconcile_playlists(ytm_tracks: list[dict], local_tracks: dict[str, list[dict]]) -> None:
    """Rewrite each local entry's `playlists` to match the LIVE YTM library.

    content.toml can drift from reality in two ways:
      * a song's video_id changed (YTM re-release) — the old on-disk file
        is still tagged with the playlist, but YTM now lists a different
        video_id for that song, so the playlist effectively no longer contains
        the old file;
      * a song was removed from a playlist on YTM, but its stored
        `playlists` entry was never cleared.
    Rebuilding playlist membership from the live library keeps the generated
    .m3u8 files in sync with what YTM actually shows.
    """
    # video_id -> set of playlist titles it currently belongs to on YTM.
    live: dict[str, set[str]] = {}
    for t in ytm_tracks:
        vid = t.get("video_id")
        pl  = t.get("playlist", "")
        if vid and pl:
            live.setdefault(vid, set()).add(pl)

    for entries in local_tracks.values():
        for entry in entries:
            vid = entry.get("youtube_id", "")
            entry["playlists"] = sorted(live.get(vid, set()))


def fetch_ytm_library(ytm: YTMusic) -> list[dict]:
    """Fetch all tracks from every YTM library playlist."""
    tracks = []
    print("  Fetching library playlists...")
    playlists = ytm.get_library_playlists(limit=1000)

    for playlist in playlists:
        playlist_id    = playlist.get("playlistId")
        playlist_title = playlist.get("title", "Unknown Playlist")

        if not playlist_id or playlist_title == "Liked Songs":
            print(f"    Skipping: {playlist_title}")
            continue

        print(f"    Fetching: {playlist_title}")
        try:
            data = ytm.get_playlist(playlist_id, limit=10000)
            for item in data.get("tracks", []):
                video_id = item.get("videoId")
                if video_id:
                    album = item.get("album") or {}
                    tracks.append({
                        "video_id": video_id,
                        "title":    item.get("title", "Unknown"),
                        "artist":   ", ".join(a.get("name", "Unknown") for a in item.get("artists", [])),
                        "album":    album.get("name", ""),
                        "album_id": album.get("id", ""),
                        "playlist": playlist_title,
                    })
        except Exception as e:
            print(f"    Failed to fetch {playlist_title}: {e}")

    return tracks


