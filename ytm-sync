#!/usr/bin/env python3
"""YTM-Sync: Sync YouTube Music library to local files."""

import argparse
import json
import os
import sys
import toml
from pathlib import Path

from yt_dlp import YoutubeDL
import ytmusicapi
from ytmusicapi import YTMusic
from ytmusicapi.helpers import get_authorization, initialize_headers, sapisid_from_cookie

AUTH_FILE = Path.home() / ".local" / "share" / "ytm-sync" / "auth.txt"
CONFIG_FILE = Path.home() / ".config" / "ytm-sync" / "config.toml"
DEFAULT_MUSIC_DIR = Path.home() / "Music"


def load_config() -> dict:
    """Load config from file, with defaults."""
    config = {
        "download_path": str(DEFAULT_MUSIC_DIR),
    }

    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, "r") as f:
            user_config = toml.load(f)
            if "download_path" in user_config:
                config["download_path"] = user_config["download_path"]

    return config


def get_music_dir(config: dict | None = None) -> Path:
    """Get the music directory from config."""
    if config is None:
        config = load_config()
    return Path(config["download_path"]).expanduser()


def validate_download_path(path: Path) -> bool:
    """Check if download path exists and is writable."""
    if not path.exists():
        print(f"  Error: Directory does not exist: {path}")
        return False
    if not path.is_dir():
        print(f"  Error: Path is not a directory: {path}")
        return False
    if not os.access(path, os.W_OK):
        print(f"  Error: Directory is not writable: {path}")
        return False
    return True


def _normalize_json_like_headers(raw: str) -> str | None:
    """Try to normalize JSON-like headers (quoted keys) to raw format."""
    import re
    
    lines = []
    for line in raw.split("\n"):
        line = line.strip()
        if not line:
            continue
        match = re.match(r'"([^"]+)"\s*:\s*"(.*)"', line)
        if match:
            key, value = match.groups()
            lines.append(f"{key}: {value}")
    
    if lines:
        return "\n".join(lines)
    return None


def _normalize_raw_headers(raw: str) -> str:
    """Normalize raw headers into Name: Value format."""
    PSEUDO_HEADERS = {":authority", ":method", ":path", ":scheme", ":status"}

    if "^[E" in raw or "\x1bE" in raw or "\x1b" in raw:
        sep = "^[E" if "^[E" in raw else ("\x1bE" if "\x1bE" in raw else "\x1b")
        parts = raw.split(sep)
        lines = []
        i = 0
        while i + 1 < len(parts):
            name = parts[i].strip()
            value = parts[i + 1].strip()
            i += 2
            if not name or name in PSEUDO_HEADERS:
                continue
            lines.append(f"{name}: {value}")
        return "\n".join(lines)

    raw_lines = [line for line in raw.split("\n") if line.strip()]
    colon_lines = sum(1 for line in raw_lines if ": " in line)
    is_alternating = len(raw_lines) > 2 and colon_lines < len(raw_lines) * 0.2

    if is_alternating:
        lines = []
        i = 0
        while i + 1 < len(raw_lines):
            name = raw_lines[i].strip()
            value = raw_lines[i + 1].strip()
            i += 2
            if name in PSEUDO_HEADERS:
                continue
            lines.append(f"{name}: {value}")
        return "\n".join(lines)

    result = []
    for line in raw_lines:
        stripped = line.strip()
        if stripped.startswith(":"):
            continue
        result.append(stripped)
    return "\n".join(result)


def _setup_from_cookies(cookie_str: str) -> bool:
    """Setup auth from a cookie string."""
    try:
        sapisid = sapisid_from_cookie(cookie_str)
    except Exception:
        print("  SAPISID cookie not found in cookies.")
        return False

    headers = dict(initialize_headers())
    headers["cookie"] = cookie_str
    headers["x-goog-authuser"] = "0"

    origin = "https://music.youtube.com"
    headers["authorization"] = get_authorization(sapisid + " " + origin)

    AUTH_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(AUTH_FILE, "w") as f:
        json.dump(headers, f, ensure_ascii=True, indent=4, sort_keys=True)

    print(f"  Auth configured from cookies.")
    return validate_auth()


def setup_auth(download_path: str | None = None) -> bool:
    """Interactive auth setup - paste JSON cookies or headers."""
    print("=" * 60)
    print("  YTM-Sync Authentication Setup")
    print("=" * 60)
    print()
    
    if download_path:
        music_dir = Path(download_path).expanduser()
    else:
        print("  Download path (default: ~/Music):")
        path_input = input("  > ").strip()
        if path_input:
            music_dir = Path(path_input).expanduser()
        else:
            music_dir = DEFAULT_MUSIC_DIR
    
    if not validate_download_path(music_dir):
        return False
    
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        toml.dump({"download_path": str(music_dir)}, f)
    
    print(f"  Using download path: {music_dir}")
    print(f"  Config saved to {CONFIG_FILE}")
    print()
    print("  Paste cookies as JSON (from DevTools > Application > Cookies > Export)")
    print("  Or paste raw request headers.")
    print()
    print("  Press Enter on an empty line when done:")
    print()

    import sys
    lines = []
    while True:
        try:
            line = input()
            if line == "":
                break
            lines.append(line)
        except EOFError:
            break
    raw = "\n".join(lines).strip()

    if not raw:
        print("  No input provided.")
        return False

    # Try parsing as JSON
    try:
        import json
        data = json.loads(raw)
        if isinstance(data, dict):
            if "Request Cookies" in data:
                cookies = data["Request Cookies"]
            else:
                cookies = data
            cookie_str = "; ".join(f"{k}={v}" for k, v in cookies.items())

            print("  Detected JSON cookies format.")
            return _setup_from_cookies(cookie_str)
    except (json.JSONDecodeError, ValueError) as e:
        print(f"  Not JSON: {e}")

    # Try as raw headers
    normalized = _normalize_raw_headers(raw)
    
    # Try JSON-like format if raw headers didn't work
    if normalized is None or "cookie" not in normalized.lower():
        json_like = _normalize_json_like_headers(raw)
        if json_like and "cookie" in json_like.lower():
            normalized = json_like

    if normalized is None or "cookie" not in normalized.lower():
        print("  Error: No cookie/header data detected.")
        return False

    AUTH_FILE.parent.mkdir(parents=True, exist_ok=True)

    import ytmusicapi
    try:
        ytmusicapi.setup(filepath=str(AUTH_FILE), headers_raw=normalized)
        print(f"  Auth file configured at {AUTH_FILE}")
    except Exception as e:
        print(f"  Failed to setup auth: {e}")
        return False

    return validate_auth()


def validate_auth() -> bool:
    """Validate that auth credentials work."""
    if not AUTH_FILE.exists():
        print("  No auth file found. Run 'ytm-sync setup' first.")
        return False

    try:
        ytm = YTMusic(str(AUTH_FILE))
        raw_response = None
        orig_post = ytm._session.post

        def _capture_post(*args, **kwargs):
            nonlocal raw_response
            resp = orig_post(*args, **kwargs)
            if resp.status_code == 200 and "browse" in str(args[0]):
                raw_response = resp.json()
            return resp

        ytm._session.post = _capture_post
        try:
            ytm.get_library_playlists(limit=1)
        finally:
            ytm._session.post = orig_post

        if raw_response:
            for stp in raw_response.get("responseContext", {}).get("serviceTrackingParams", []):
                for param in stp.get("params", []):
                    if param.get("key") == "logged_in" and param.get("value") == "0":
                        print("  Auth validation failed: logged_in=0")
                        return False

        print("  Authentication successful!")
        return True
    except Exception as e:
        print(f"  Auth validation failed: {e}")
        return False


def get_ytmusic_client() -> YTMusic:
    """Create and return authenticated YTMusic client."""
    if not AUTH_FILE.exists():
        raise RuntimeError("Not authenticated. Run 'ytm-sync setup' first.")
    return YTMusic(str(AUTH_FILE))


def load_content_toml(music_dir: Path) -> dict:
    """Load the content.toml file."""
    content_file = music_dir / "content.toml"
    if not content_file.exists():
        return {"tracks": [], "playlists": []}

    with open(content_file, "r") as f:
        return toml.load(f)


def get_local_tracks(content: dict) -> dict[str, list[dict]]:
    """Build a dict of video_id -> list of track infos from content.toml."""
    local = {}
    for track in content.get("tracks", []):
        if "youtube_id" in track:
            vid = track["youtube_id"]
            if vid not in local:
                local[vid] = []
            local[vid].append(track)
    return local


def fetch_ytm_library(ytm: YTMusic) -> list[dict]:
    """Fetch all tracks from YTM library."""
    tracks = []

    print("  Fetching library playlists...")
    playlists = ytm.get_library_playlists(limit=1000)
    for playlist in playlists:
        playlist_id = playlist.get("playlistId")
        if not playlist_id:
            continue

        playlist_title = playlist.get("title", "Unknown Playlist")

        if playlist_title == "Liked Songs":
            print(f"    Skipping playlist: {playlist_title}")
            continue

        print(f"    Fetching playlist: {playlist_title}")

        try:
            tracks_data = ytm.get_playlist(playlist_id, limit=10000)
            for item in tracks_data.get("tracks", []):
                video_id = item.get("videoId")
                if video_id:
                    tracks.append({
                        "video_id": video_id,
                        "title": item.get("title", "Unknown"),
                        "artist": ", ".join(a.get("name", "Unknown") for a in item.get("artists", [])),
                        "album": (item.get("album") or {}).get("name", ""),
                        "playlist": playlist_title,
                    })
        except Exception as e:
            print(f"    Failed to fetch playlist {playlist_title}: {e}")

    return tracks


def get_stream_url(video_id: str) -> str | None:
    """Get stream URL for a video using yt-dlp."""
    ydl_opts = {
        "quiet": True,
        "skip_download": True,
        "format": "bestaudio/best",
        "noplaylist": True,
    }

    url = f"https://music.youtube.com/watch?v={video_id}"
    try:
        with YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=False)
            return info.get("url")
    except Exception as e:
        print(f"    Failed to get stream URL for {video_id}: {e}")
        return None


def download_track(video_id: str, title: str, artist: str, playlist: str, music_dir: Path) -> bool:
    """Download a single track using yt-dlp as AAC/M4A."""
    import subprocess
    import shlex
    import time
    
    safe_artist = "".join(c for c in artist if c not in "/\\?%*|\"<>:()")
    safe_title = "".join(c for c in title if c not in "/\\?%*|\"<>:()")
    safe_playlist = "".join(c for c in playlist if c not in "/\\?%*|\"<>:()") if playlist else "Liked Songs"

    output_dir = music_dir / safe_playlist
    output_dir.mkdir(parents=True, exist_ok=True)

    base_path = output_dir / f"{safe_artist} - {safe_title}"
    url = f"https://music.youtube.com/watch?v={video_id}"

    try:
        cmd = [
            "yt-dlp",
            "--embed-thumbnail",
            "--embed-metadata",
            "--metadata", f"genre={playlist}",
            "-x", "--audio-format", "m4a", "--audio-quality", "0",
            "-w",
            "-o", str(base_path) + ".%(ext)s",
            url
        ]
        
        result = subprocess.run(cmd, capture_output=True, timeout=300)
        
        if result.returncode != 0:
            stderr = result.stderr.decode()
            if "The downloaded file is empty" in stderr or "Did not get any data blocks" in stderr:
                print(f"    {playlist}: Rate limited or empty download for {artist} - {title}, skipping")
                return False
            print(f"    {playlist}: Failed to download {artist} - {title}: {stderr}")
            return False
        
        time.sleep(0.1)
        
        m4a_path = None
        for ext in [".m4a", ".webm", ".opus"]:
            candidates = list(output_dir.glob(f"{safe_artist} - {safe_title}{ext}*"))
            for p in candidates:
                if p.stat().st_size > 0:
                    m4a_path = p
                    break
            if m4a_path:
                break
        
        if not m4a_path:
            print(f"    Failed to find downloaded file for {artist} - {title}")
            return False
        
        if m4a_path.stat().st_size < 1000:
            print(f"    Empty file for {artist} - {title}, skipping")
            m4a_path.unlink(missing_ok=True)
            return False
        
        final_path = base_path.with_suffix(".m4a")
        
        if m4a_path.suffix != ".m4a" or m4a_path.stat().st_size < 10000:
            result = subprocess.run([
                "ffmpeg", "-y", "-i", str(m4a_path),
                "-c:a", "aac", "-b:a", "320k",
                "-movflags", "+faststart",
                str(final_path)
            ], capture_output=True, timeout=300)
            
            if final_path.exists() and final_path.stat().st_size > 10000:
                if m4a_path != final_path:
                    m4a_path.unlink()
                m4a_path = final_path
            else:
                print(f"    Failed to convert {artist} - {title}")
                return False
        
        if m4a_path != base_path.with_suffix(".m4a"):
            final_path = base_path.with_suffix(".m4a")
            m4a_path.rename(final_path)
            m4a_path = final_path

        for f in output_dir.glob(f"{safe_artist} - {safe_title}.*"):
            if f != m4a_path:
                f.unlink(missing_ok=True)
        
        print(f"    {playlist}: {artist} - {title}")
        return True
    except Exception as e:
        print(f"    {playlist}: Failed to download {artist} - {title}: {e}")
        return False


def sync(playlist_filter: str | list[str] | None = None, config: dict | None = None):
    """Main sync logic."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync")
    print("=" * 40)
    print(f"\n  Download path: {music_dir}")

    if playlist_filter is None or playlist_filter == []:
        filters = None
    elif isinstance(playlist_filter, str):
        filters = [playlist_filter.lower()]
    else:
        filters = [f.lower() for f in playlist_filter]

    if filters:
        print(f"\n  Filtering to playlists: {', '.join(filters)}")

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    print("\nLoading local library...")
    content = load_content_toml(music_dir)
    local_tracks = get_local_tracks(content)

    print(f"  Found {len(local_tracks)} tracks in content.toml")

    print("\nFetching YTM library...")
    ytm = get_ytmusic_client()
    ytm_tracks = fetch_ytm_library(ytm)

    print(f"  Found {len(ytm_tracks)} tracks in YTM library")

    to_download = []
    to_copy = []
    for track in ytm_tracks:
        video_id = track["video_id"]
        playlist = track.get("playlist", "Liked Songs")
        
        if video_id not in local_tracks:
            if filters is None or playlist.lower() in filters:
                to_download.append(track)
        else:
            existing_entries = local_tracks[video_id]
            track_found = False
            
            safe_artist = "".join(c for c in track["artist"] if c not in "/\\?%*|\"<>:()")
            safe_title = "".join(c for c in track["title"] if c not in "/\\?%*|\"<>:()")
            
            for existing in existing_entries:
                existing_path = Path(existing.get("path", "").replace("~", str(Path.home())))
                
                if existing_path.exists():
                    target_path = music_dir / playlist / existing_path.name
                    if target_path.exists():
                        track_found = True
                        break
                    else:
                        if filters is None or playlist.lower() in filters:
                            to_copy.append((track, existing_path, playlist))
                            track_found = True
                            break
                else:
                    dir_path = existing_path.parent
                    if dir_path.exists():
                        for f in dir_path.glob(f"{safe_artist} - {safe_title}*"):
                            if f.suffix == ".m4a":
                                target_path = music_dir / playlist / f.name
                                if target_path.exists():
                                    track_found = True
                                    break
                                else:
                                    if filters is None or playlist.lower() in filters:
                                        to_copy.append((track, f, playlist))
                                        track_found = True
                                        break
                        if track_found:
                            break
            
            if not track_found:
                if filters is None or playlist.lower() in filters:
                    to_download.append(track)

    print(f"\n  {len(to_download)} tracks need to be downloaded")
    print(f"  {len(to_copy)} tracks need to be copied")

    if not to_download and not to_copy:
        print("\nLibrary is up to date!")
        return

    successful_downloads = []
    successful_copies = []

    if to_copy:
        print("\nCopying tracks to new playlists...")
        success_count = 0
        total = len(to_copy)
        pad = len(str(total))
        for i, (track, existing_path, new_playlist) in enumerate(to_copy, 1):
            print(f"  [{i:0{pad}d}/{total}] ", end="")
            try:
                new_dir = music_dir / new_playlist
                new_dir.mkdir(parents=True, exist_ok=True)
                new_path = new_dir / existing_path.name
                
                import shutil
                shutil.copy2(existing_path, new_path)
                
                successful_copies.append((track, new_path))
                success_count += 1
                print(f"{new_playlist}: {track['artist']} - {track['title']}")
            except Exception as e:
                print(f"  Failed to copy {track['artist']} - {track['title']}: {e}")
        
        print(f"\nCopied {success_count}/{len(to_copy)} tracks")

    if to_download:
        print("\nDownloading missing tracks...")
        success_count = 0
        total = len(to_download)
        pad = len(str(total))
        for i, track in enumerate(to_download, 1):
            print(f"  [{i:0{pad}d}/{total}] ", end="")
            if download_track(
                track["video_id"],
                track["title"],
                track["artist"],
                track.get("playlist", "Liked Songs"),
                music_dir,
            ):
                success_count += 1
                successful_downloads.append(track)

        print(f"\nDownloaded {success_count}/{len(to_download)} tracks")

    if successful_downloads or successful_copies:
        print("\nUpdating content.toml...")
        
        for track in successful_downloads:
            vid = track["video_id"]
            safe_artist = "".join(c for c in track["artist"] if c not in "/\\?%*|\"<>:")
            safe_title = "".join(c for c in track["title"] if c not in "/\\?%*|\"<>:")
            safe_playlist = "".join(c for c in track.get("playlist", "Liked Songs") if c not in "/\\?%*|\"<>:")
            rel_path = str(music_dir / safe_playlist / f"{safe_artist} - {safe_title}.m4a").replace(str(Path.home()), "~")
            new_entry = {
                "youtube_id": vid,
                "path": rel_path,
                "name": track["title"],
                "artist": track["artist"],
                "album": track.get("album", ""),
                "playlist": track.get("playlist", "Liked Songs"),
            }
            if vid not in local_tracks:
                local_tracks[vid] = [new_entry]
            else:
                local_tracks[vid].append(new_entry)
        
        for track, new_path in successful_copies:
            vid = track["video_id"]
            rel_path = str(new_path).replace(str(Path.home()), "~")
            new_entry = {
                "youtube_id": vid,
                "path": rel_path,
                "name": track["title"],
                "artist": track["artist"],
                "album": track.get("album", ""),
                "playlist": track.get("playlist", "Liked Songs"),
            }
            if vid not in local_tracks:
                local_tracks[vid] = [new_entry]
            else:
                local_tracks[vid].append(new_entry)

        content_file = music_dir / "content.toml"
        with open(content_file, "w") as f:
            f.write("# YTM-Sync Content Library\n\n")
            all_tracks = []
            for track_list in local_tracks.values():
                all_tracks.extend(track_list)
            f.write(toml.dumps({"tracks": all_tracks}))
        print(f"  Updated {content_file}")

        print("\nGenerating m3u playlist files...")
        for playlist_dir in music_dir.iterdir():
            if not playlist_dir.is_dir():
                continue
            if playlist_dir.name.startswith("."):
                continue
            m3u_path = playlist_dir / f"{playlist_dir.name}.m3u8"
            tracks = sorted(playlist_dir.glob("*.m4a"))
            if tracks:
                with open(m3u_path, "w") as f:
                    f.write("#EXTM3U\n")
                    for track in tracks:
                        rel_path = f"{playlist_dir.name}/{track.name}"
                        f.write(f"{rel_path}\n")
                print(f"  Created {m3u_path.name}")


def scan_library(config: dict | None = None):
    """Scan existing files and build content.toml."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Scan")
    print("=" * 40)
    print(f"\n  Scan path: {music_dir}")

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    ytm = get_ytmusic_client()

    print("\nFetching YTM library for track IDs...")
    ytm_tracks = fetch_ytm_library(ytm)
    
    ytm_by_name = {}
    for track in ytm_tracks:
        safe_artist = "".join(c for c in track["artist"] if c not in "/\\?%*|\"<>:()").lower()
        safe_title = "".join(c for c in track["title"] if c not in "/\\?%*|\"<>:()").lower()
        key = f"{safe_artist} - {safe_title}"
        if key not in ytm_by_name:
            ytm_by_name[key] = []
        ytm_by_name[key].append(track)

    tracks = {}

    for playlist_dir in music_dir.iterdir():
        if not playlist_dir.is_dir():
            continue
        if playlist_dir.name.startswith("."):
            continue
        
        for track_file in playlist_dir.glob("*.m4a"):
            if not track_file.is_file():
                continue
            
            name = track_file.stem
            if " - " in name:
                artist, title = name.split(" - ", 1)
            else:
                artist = "Unknown"
                title = name
            
            safe_artist = "".join(c for c in artist if c not in "/\\?%*|\"<>:()").lower()
            safe_title = "".join(c for c in title if c not in "/\\?%*|\"<>:()").lower()
            key = f"{safe_artist} - {safe_title}"
            
            ytm_match = ytm_by_name.get(key)
            
            if not ytm_match:
                continue
            
            matched_track = ytm_match[0]
            youtube_id = matched_track["video_id"]
            
            rel_path = str(track_file).replace(str(Path.home()), "~")
            
            new_entry = {
                "youtube_id": youtube_id,
                "path": rel_path,
                "name": title,
                "artist": artist,
                "album": "",
                "playlist": playlist_dir.name,
            }
            
            if youtube_id not in tracks:
                tracks[youtube_id] = []
            
            existing_paths = [t.get("path") for t in tracks[youtube_id]]
            if rel_path not in existing_paths:
                tracks[youtube_id].append(new_entry)

    count = sum(len(v) for v in tracks.values())
    print(f"\n  Found {count} tracks")

    if count > 0:
        content_file = music_dir / "content.toml"
        all_tracks = []
        for track_list in tracks.values():
            all_tracks.extend(track_list)
        with open(content_file, "w") as f:
            f.write("# YTM-Sync Content Library\n\n")
            f.write(toml.dumps({"tracks": all_tracks}))
        print(f"  Updated {content_file}")
    else:
        print("  No tracks found")


def fix_playlists(config: dict | None = None):
    """Fix m3u8 playlist files with correct paths."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Fix Playlists")
    print("=" * 40)
    print(f"\n  Music path: {music_dir}")

    content_file = music_dir / "content.toml"
    if not content_file.exists():
        print("\n  No content.toml found. Run 'scan' first.")
        return

    content = toml.load(content_file)
    tracks = content.get("tracks", [])

    playlists = {}
    for track in tracks:
        playlist = track.get("playlist", "Unknown")
        if playlist not in playlists:
            playlists[playlist] = []
        
        path = track.get("path", "")
        if path:
            full_path = Path(path.replace("~", str(Path.home())))
            if full_path.exists():
                playlists[playlist].append(full_path)

    print(f"\n  Found {len(playlists)} playlists")

    for playlist, track_files in playlists.items():
        if not track_files:
            continue
        
        playlist_dir = music_dir / playlist
        playlist_dir.mkdir(parents=True, exist_ok=True)
        
        m3u_path = playlist_dir / f"{playlist}.m3u8"
        
        with open(m3u_path, "w") as f:
            f.write("#EXTM3U\n")
            for track_file in sorted(track_files):
                f.write(f"{track_file}\n")
        
        print(f"  Updated {m3u_path.name} ({len(track_files)} tracks)")


def get_track(query: str, config: dict | None = None):
    """Interactive search and download a single track."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Get")
    print("=" * 40)

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    ytm = get_ytmusic_client()

    print(f"\n  Searching for: {query}")
    
    results = ytmusicapi.YTMusic.search(query, "songs", limit=10)
    
    if not results:
        print("  No results found.")
        return

    print("\n  Results:")
    for i, result in enumerate(results, 1):
        title = result.get("title", "Unknown")
        artists = ", ".join(a.get("name", "Unknown") for a in result.get("artists", []))
        album = result.get("album", {}).get("name", "") if result.get("album") else ""
        print(f"  {i}. {artists} - {title}")
        if album:
            print(f"     Album: {album}")

    print("\n  Enter number to download (or 'q' to quit):")
    choice = input("  > ").strip()

    if choice.lower() == 'q':
        print("  Cancelled.")
        return

    try:
        idx = int(choice) - 1
        if idx < 0 or idx >= len(results):
            print("  Invalid choice.")
            return
    except ValueError:
        print("  Invalid input.")
        return

    result = results[idx]
    video_id = result.get("videoId")
    title = result.get("title", "Unknown")
    artists = ", ".join(a.get("name", "Unknown") for a in result.get("artists", []))
    album = result.get("album", {}).get("name", "") if result.get("album") else ""

    if not video_id:
        print("  No video ID found.")
        return

    print(f"\n  Downloading: {artists} - {title}")

    output_dir = music_dir / "__GET__"
    if album:
        output_dir = output_dir / album
    output_dir.mkdir(parents=True, exist_ok=True)

    base_path = output_dir / f"{artists} - {title}"
    url = f"https://music.youtube.com/watch?v={video_id}"

    cmd = [
        "yt-dlp",
        "--embed-thumbnail",
        "--embed-metadata",
        "-x", "--audio-format", "m4a", "--audio-quality", "0",
        "-o", str(base_path) + ".%(ext)s",
        url
    ]

    result_dl = subprocess.run(cmd, capture_output=True, timeout=300)

    if result_dl.returncode != 0:
        print(f"  Download failed: {result_dl.stderr.decode()}")
        return

    m4a_path = None
    safe_artist = "".join(c for c in artists if c not in "/\\?%*|\"<>:()").replace("'", "")
    safe_title = "".join(c for c in title if c not in "/\\?%*|\"<>:()").replace("'", "")
    
    for ext in [".m4a", ".webm", ".opus"]:
        candidates = list(output_dir.glob(f"{safe_artist} - {safe_title}{ext}*"))
        for p in candidates:
            if p.stat().st_size > 0:
                m4a_path = p
                break
        if m4a_path:
            break
    
    if not m4a_path:
        for ext in [".m4a", ".webm", ".opus"]:
            candidates = list(output_dir.glob(f"*{ext}*"))
            for p in candidates:
                if p.stat().st_size > 10000:
                    m4a_path = p
                    break
            if m4a_path:
                break

    if not m4a_path:
        print("  Failed to find downloaded file.")
        return

    final_path = base_path.with_suffix(".m4a")
    if m4a_path.suffix != ".m4a":
        conv_result = subprocess.run([
            "ffmpeg", "-y", "-i", str(m4a_path),
            "-c:a", "aac", "-b:a", "320k",
            "-movflags", "+faststart",
            str(final_path)
        ], capture_output=True, timeout=300)
        
        if final_path.exists() and final_path.stat().st_size > 10000:
            m4a_path.unlink()
            m4a_path = final_path
        else:
            print("  Failed to convert file.")
            return

    if m4a_path != final_path:
        m4a_path.rename(final_path)
        m4a_path = final_path

    for f in output_dir.glob(f"{artists} - {title}.*"):
        if f != m4a_path:
            f.unlink(missing_ok=True)

    print(f"  Downloaded: {m4a_path}")

    print("\n  Opening with default player...")
    subprocess.run(["xdg-open", str(m4a_path)])


def list_library():
    """List playlists and track counts without downloading."""
    print("YTM-Sync Library")
    print("=" * 40)

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    ytm = get_ytmusic_client()

    print("\nLiked Songs:")
    liked = ytm.get_liked_songs(limit=10000)
    liked_count = len(liked.get("tracks", []))
    print(f"  {liked_count} tracks")

    print("\nLibrary Songs:")
    lib_songs = ytm.get_library_songs(limit=10000)
    print(f"  {len(lib_songs)} tracks")

    print("\nSubscribed Artists:")
    artists = ytm.get_library_subscriptions(limit=1000)
    for artist in artists[:10]:
        name = artist.get("artist", "Unknown")
        print(f"  {name}")
    if len(artists) > 10:
        print(f"  ... and {len(artists) - 10} more")
    print(f"  Total: {len(artists)} artists")

    print("\nLibrary Playlists:")
    playlists = ytm.get_library_playlists(limit=1000)
    for playlist in playlists:
        title = playlist.get("title", "Unknown")
        playlist_id = playlist.get("playlistId", "")
        try:
            info = ytm.get_playlist(playlist_id, limit=1)
            count = info.get("trackCount", "?")
        except:
            count = "?"
        print(f"  {title}: {count} tracks")

    print(f"\nTotal playlists: {len(playlists)}")


def main():
    try:
        parser = argparse.ArgumentParser(description="YTM-Sync: Sync YouTube Music to local files")
        subparsers = parser.add_subparsers(dest="command", required=True)

        setup_parser = subparsers.add_parser("setup", help="Set up authentication")
        setup_parser.add_argument("-p", "--path", help="Download path (default: ~/Music or config file)")
        sync_parser = subparsers.add_parser("sync", help="Sync library")
        sync_parser.add_argument("playlist", nargs="*", help="Sync specific playlist(s) only")
        sync_parser.add_argument("-p", "--path", help="Download path (default: ~/Music or config file)")
        subparsers.add_parser("validate", help="Validate authentication")
        subparsers.add_parser("list", help="List playlists and track counts")
        scan_parser = subparsers.add_parser("scan", help="Scan existing files and build content.toml")
        scan_parser.add_argument("-o", "--path", help="Scan path (default: ~/Music or config file)")
        fix_parser = subparsers.add_parser("fix-playlists", help="Fix m3u8 playlist files")
        fix_parser.add_argument("-o", "--path", help="Music path (default: ~/Music or config file)")
        get_parser = subparsers.add_parser("get", help="Search and download a single track")
        get_parser.add_argument("query", nargs="+", help="Search query")
        get_parser.add_argument("-o", "--path", help="Music path (default: ~/Music or config file)")

        args = parser.parse_args()

        if args.command == "setup":
            success = setup_auth(args.path)
            sys.exit(0 if success else 1)
        elif args.command == "sync":
            if args.path:
                config = {"download_path": args.path}
                sync(args.playlist, config)
            else:
                sync(args.playlist)
        elif args.command == "validate":
            config = load_config()
            music_dir = get_music_dir(config)
            print(f"  Download path: {music_dir}")
            success = validate_auth()
            sys.exit(0 if success else 1)
        elif args.command == "list":
            list_library()
        elif args.command == "scan":
            if args.path:
                scan_library({"download_path": args.path})
            else:
                scan_library()
        elif args.command == "fix-playlists":
            if args.path:
                fix_playlists({"download_path": args.path})
            else:
                fix_playlists()
        elif args.command == "get":
            query = " ".join(args.query)
            if args.path:
                get_track(query, {"download_path": args.path})
            else:
                get_track(query)
    except KeyboardInterrupt:
        print("\nExiting...")
        sys.exit(130)


if __name__ == "__main__":
    main()
