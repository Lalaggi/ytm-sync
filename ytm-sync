def sync(playlist_filter: str | list[str] | None = None, config: dict | None = None) -> None:
    """Fetch YTM library and download any missing tracks."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync")
    print("=" * 40)
    print(f"\n  Download path: {music_dir}")

    if not playlist_filter:
        filters = None
    elif isinstance(playlist_filter, str):
        filters = [playlist_filter.lower()]
    else:
        filters = [f.lower() for f in playlist_filter]

    if filters:
        print(f"  Filtering to: {', '.join(filters)}")

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    print("\nLoading local library...")
    local_tracks = get_local_tracks(load_content_toml(music_dir))
    song_index = build_song_index(local_tracks)
    print(f"  {len(local_tracks)} tracks in content.toml")

    print("\nFetching YTM library...")
    ytm_tracks = fetch_ytm_library(get_ytmusic_client())

    # Reconcile stored playlist membership with the live library so generated
    # .m3u8 files match what YTM actually shows (drops drifted/removed tracks).
    reconcile_playlists(ytm_tracks, local_tracks)

    # Deduplicate by (video_id, playlist) pair — YTM sometimes returns the same track
    # multiple times within a single playlist
    seen: set[tuple[str, str]] = set()
    deduped: list[dict] = []
    for t in ytm_tracks:
        key = (t["video_id"], t.get("playlist", ""))
        if key not in seen:
            seen.add(key)
            deduped.append(t)
    ytm_tracks = deduped

    print(f"  {len(ytm_tracks)} unique tracks in YTM library")

    to_download:     list[dict] = []
    to_add_playlist: list[dict] = []
    to_refresh:      list[dict] = []  # same song already on disk, just update metadata

    def _on_disk(entries: list[dict]) -> bool:
        return any(expand_path(e.get("path", ""), music_dir).exists() for e in entries)

    def _known(existing: object, playlist: str) -> bool:
        if not isinstance(existing, (list, tuple)):
            return False
        names = [p.lower() for e in existing if isinstance(e, dict)
                for p in pl_list(e)]
        return playlist.lower() in names

    for track in ytm_tracks:
        vid      = track["video_id"]
        playlist = track.get("playlist", "")
        skey     = song_key(track["artist"], track["title"], track.get("album_id", ""))

        if filters and playlist.lower() not in filters:
            continue

        # Case 1: exact video_id already downloaded & present on disk.
        if vid in local_tracks and _on_disk(local_tracks[vid]):
            playlist_known = _known(local_tracks.get(vid), playlist)
            if not playlist_known:
                to_add_playlist.append(track)
            continue

        # Case 2: same SONG (artist/title[/album_id]) already on disk under a
        # different video_id — YTM repointed this entry at a re-released version.
        # Don't re-download; just refresh the stored metadata to the current id.
        if skey in song_index and _on_disk(song_index[skey]):
            playlist_known = _known(song_index.get(skey), playlist)
            if not playlist_known:
                to_add_playlist.append(track)
            else:
                to_refresh.append(track)
            continue

        # Case 3: genuinely new — download it.
        to_download.append(track)

    print(f"\n  {len(to_download)} tracks to download")
    print(f"  {len(to_add_playlist)} tracks to add to new playlists")

    if not to_download and not to_add_playlist:
        print("\nLibrary is up to date!")
        return

    for track in to_add_playlist:
        vid      = track["video_id"]
        playlist = track.get("playlist", "")
        # Add the playlist to the song's existing entry rather than creating a
        # second entry for the same file (one entry per song, many playlists).
        target = None
        if vid in local_tracks:
            target = next((e for e in local_tracks[vid]
                           if expand_path(e.get("path", ""), music_dir).exists()), None)
        if target is None:
            target = make_track_entry(track, music_dir)
            local_tracks.setdefault(vid, []).append(target)
        add_playlist(target, playlist)

    downloaded_paths: list[Path] = []
    if to_download:
        print("\nDownloading missing tracks...")
        pad = len(str(len(to_download)))
        for i, track in enumerate(to_download, 1):
            print(f"  [{i:0{pad}d}/{len(to_download)}] ", end="", flush=True)
            path = download_track(
                track["video_id"], track["title"], track["artist"],
                track.get("album", ""), track.get("playlist", ""),
                music_dir,
            )
            if path:
                downloaded_paths.append(path)
                # Remove stale entries for this video_id (paths that no longer exist)
                vid = track["video_id"]
                local_tracks[vid] = [
                    e for e in local_tracks.get(vid, [])
                    if expand_path(e.get("path", ""), music_dir).exists()
                ]
                local_tracks.setdefault(vid, []).append(
                    make_track_entry(track, music_dir)
                )

        print(f"\nDownloaded {len(downloaded_paths)}/{len(to_download)} tracks")

        if downloaded_paths:
            print("\nCropping cover art...")
            for path in downloaded_paths:
                try:
                    crop_cover_art(path)
                except Exception as e:
                    print(f"    Warning: Crop failed for {path.name}: {e}")

    if downloaded_paths or to_add_playlist:
        # Refresh metadata for songs YTM now serves under a re-released
        # video_id/album: point the existing on-disk entry at the current id
        # so future syncs recognise it (no re-download).
        for track in to_refresh:
            skey = song_key(track["artist"], track["title"], track.get("album_id", ""))
            for entry in song_index.get(skey, []):
                if expand_path(entry.get("path", ""), music_dir).exists():
                    entry["youtube_id"] = track["video_id"]
                    entry["album"]      = track.get("album", entry.get("album", ""))
                    entry["album_id"]   = track.get("album_id", entry.get("album_id", ""))
                    add_playlist(entry, track.get("playlist", ""))

        write_content_toml(music_dir, local_tracks)
        print("\nGenerating playlists...")
        write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))


def scan_library(config: dict | None = None) -> None:
    """Scan existing files on disk and rebuild content.toml from YTM metadata."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Scan")
    print("=" * 40)
    print(f"\n  Scan path: {music_dir}")

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    print("\nFetching YTM library for track IDs...")
    ytm_tracks = fetch_ytm_library(get_ytmusic_client())

    ytm_by_id:   dict[str, dict]       = {}
    ytm_by_name: dict[str, list[dict]] = {}
    for track in ytm_tracks:
        vid = track.get("video_id")
        if vid:
            ytm_by_id[vid] = track
        key = f"{sanitize(track['artist']).lower()} - {sanitize(track['title']).lower()}"
        ytm_by_name.setdefault(key, []).append(track)

    def youtube_id_from_file(filepath: Path) -> str | None:
        try:
            result = subprocess.run(
                ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", str(filepath)],
                capture_output=True, text=True, timeout=10,
            )
            fmt = json.loads(result.stdout).get("format", {})
            comment = fmt.get("comment", "")
            purl = fmt.get("purl", "")

            url = purl or comment

            if "youtube.com/watch" in url:
                return url.split("v=")[-1].split("&")[0]
            if "youtu.be/" in url:
                return url.split("youtu.be/")[-1].split("?")[0]
        except (subprocess.TimeoutExpired, FileNotFoundError,
                json.JSONDecodeError, OSError):
            pass
        return None

    tracks: dict[str, list[dict]] = {}
    for entry in load_content_toml(music_dir).get("tracks", []):
        vid  = entry.get("youtube_id")
        path = entry.get("path", "")
        if vid and path and expand_path(path, music_dir).exists():
            if path not in [e.get("path") for e in tracks.get(vid, [])]:
                tracks.setdefault(vid, []).append(entry)

    known_paths = {e.get("path") for entries in tracks.values() for e in entries}

    for artist_dir in sorted(music_dir.iterdir()):
        if not artist_dir.is_dir() or artist_dir.name.startswith("."):
            continue
        for album_dir in sorted(artist_dir.iterdir()):
            if not album_dir.is_dir() or album_dir.name.startswith("."):
                continue
            for track_file in sorted(album_dir.glob("*.ogg")):
                rp = rel_path(track_file, music_dir)
                if rp in known_paths:
                    continue

                vid = youtube_id_from_file(track_file)
                stem = track_file.stem
                artist, title = stem.split(" - ", 1) if " - " in stem else ("Unknown", stem)

                match = None
                if vid and vid in ytm_by_id:
                    cand = ytm_by_id[vid]
                    # Only trust the YTM match if it actually describes THIS file
                    # (same artist + title). YTM can report a different track
                    # under a recycled id, which previously corrupted metadata.
                    if (sanitize(cand.get("artist", "")).lower() == sanitize(artist).lower()
                            and sanitize(cand.get("title", "")).lower() == sanitize(title).lower()):
                        match = cand

                if not match:
                    # Unknown or mismatched id: register the file from its OWN
                    # on-disk identity (folder = album, stem = artist/title).
                    # Do NOT fall back to name-matching another track's metadata
                    # — that is what previously wrote the wrong album/artist onto
                    # files (e.g. AURORA's album onto Bastille's "Pompeii").
                    vid = vid or f"local-{rp}"
                    entry = {
                        "youtube_id": vid,
                        "path":       rp,
                        "name":       title,
                        "artist":     artist,
                        "album":      album_dir.name,
                        "album_id":   "",
                        "playlists":  [],
                    }
                    existing = next((e for e in tracks.get(vid, [])
                                    if e.get("path") == rp), None)
                    if existing is None:
                        tracks.setdefault(vid, []).append(entry)
                    known_paths.add(rp)
                    continue

                pl_name = match.get("playlist", "")
                entry = {
                    "youtube_id": match["video_id"],
                    "path":       rp,
                    "name":       title,
                    "artist":     artist,
                    "album":      album_dir.name,
                    "album_id":   match.get("album_id", ""),
                    "playlists":  [pl_name] if pl_name else [],
                }
                existing = next((e for e in tracks.get(match["video_id"], [])
                                if e.get("path") == rp), None)
                if existing is None:
                    tracks.setdefault(match["video_id"], []).append(entry)
                else:
                    add_playlist(existing, pl_name)
                known_paths.add(rp)

    count = sum(len(v) for v in tracks.values())
    print(f"\n  Found {count} tracks")
    if count:
        write_content_toml(music_dir, tracks)
    else:
        print("  No tracks found.")


