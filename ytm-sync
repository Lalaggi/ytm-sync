#!/usr/bin/env python3
"""YTM-Sync: Sync YouTube Music library to local files."""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import toml
from pathlib import Path

from yt_dlp import YoutubeDL
from ytmusicapi import YTMusic
from ytmusicapi.helpers import get_authorization, initialize_headers, sapisid_from_cookie

AUTH_FILE = Path.home() / ".local" / "share" / "ytm-sync" / "auth.txt"
CONFIG_FILE = Path.home() / ".config" / "ytm-sync" / "config.toml"
DEFAULT_MUSIC_DIR = Path.home() / "Music"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def sanitize(name: str) -> str:
    """Replace filesystem-unsafe characters in a name."""
    return name.replace("/", "_").replace("\\", "_").replace("~", "=").strip()


def rel_path(full: Path) -> str:
    """Return a ~-relative path string for storage in content.toml.
    Only replaces the leading home directory prefix — never a ~ inside a filename."""
    home = str(Path.home())
    s = str(full)
    if s.startswith(home + "/"):
        return "~/" + s[len(home) + 1:]
    return s


def expand_path(p: str) -> Path:
    """Expand a ~-relative path string back to a full Path."""
    return Path(p.replace("~", str(Path.home())))


def make_track_entry(track: dict, music_dir: Path) -> dict:
    """Build a content.toml entry dict from a YTM track dict."""
    safe_artist = sanitize(track["artist"])
    safe_title  = sanitize(track["title"])
    safe_album  = sanitize(track.get("album") or "Unknown Album")
    full = music_dir / safe_artist / safe_album / f"{safe_artist} - {safe_title}.ogg"
    return {
        "youtube_id": track["video_id"],
        "path":       rel_path(full),
        "name":       track["title"],
        "artist":     track["artist"],
        "album":      track.get("album", ""),
        "playlist":   track.get("playlist", ""),
    }


def write_content_toml(music_dir: Path, local_tracks: dict[str, list[dict]]) -> None:
    all_tracks = [entry for entries in local_tracks.values() for entry in entries]
    content_file = music_dir / "content.toml"
    with open(content_file, "w") as f:
        f.write("# YTM-Sync Content Library\n\n")
        f.write(toml.dumps({"tracks": all_tracks}))
    print(f"  Updated {content_file}")


def write_playlists(music_dir: Path, tracks: list[dict]) -> None:
    """Write .m3u8 playlist files (relative paths) for all playlists in a track list."""
    playlists: dict[str, list[Path]] = {}
    for track in tracks:
        pl   = track.get("playlist", "Unknown")
        path = track.get("path", "")
        if path:
            playlists.setdefault(pl, []).append(expand_path(path))

    for playlist, track_paths in playlists.items():
        valid = sorted(p for p in track_paths if p.exists())
        if not valid:
            continue
        safe_pl  = sanitize(playlist)
        pl_dir   = music_dir / safe_pl
        pl_dir.mkdir(parents=True, exist_ok=True)
        m3u_path = pl_dir / f"{safe_pl}.m3u8"
        with open(m3u_path, "w") as f:
            f.write("#EXTM3U\n")
            for p in valid:
                f.write(f"{os.path.relpath(p, pl_dir)}\n")
        print(f"  Written {m3u_path.name} ({len(valid)} tracks)")


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

def load_config() -> dict:
    config = {"download_path": str(DEFAULT_MUSIC_DIR)}
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE) as f:
            user = toml.load(f)
            if "download_path" in user:
                config["download_path"] = user["download_path"]
    return config


def get_music_dir(config: dict | None = None) -> Path:
    if config is None:
        config = load_config()
    return Path(config["download_path"]).expanduser()


def validate_download_path(path: Path) -> bool:
    if not path.exists():
        print(f"  Error: Directory does not exist: {path}")
        return False
    if not path.is_dir():
        print(f"  Error: Path is not a directory: {path}")
        return False
    if not os.access(path, os.W_OK):
        print(f"  Error: Directory is not writable: {path}")
        return False
    return True


