# Library data
# ---------------------------------------------------------------------------

def load_content_toml(music_dir: Path) -> dict:
    content_file = music_dir / "content.toml"
    if not content_file.exists():
        return {"tracks": []}
    with open(content_file) as f:
        return toml.load(f)


def get_local_tracks(content: dict) -> dict[str, list[dict]]:
    """Build {video_id: [entries]} from content.toml.

    Also attaches a `song_index` mapping each stable song_key() to the list
    of entries that belong to that song, so callers can detect when YTM has
    repointed a playlist entry at a re-released version of a song we already
    have (same artist/title, different video_id/album).
    """
    local: dict[str, list[dict]] = {}
    for track in content.get("tracks", []):
        vid = track.get("youtube_id")
        if vid:
            local.setdefault(vid, []).append(track)
    return local


def build_song_index(local_tracks: dict[str, list[dict]]) -> dict[str, list[dict]]:
    """Map song_key() -> [entries] across all local tracks.

    Identity is (artist, title) only — see song_key() — so re-released
    versions (single -> album) map to the same key and can be recognised
    without re-downloading.
    """
    index: dict[str, list[dict]] = {}
    for entries in local_tracks.values():
        for entry in entries:
            key = song_key(entry.get("artist", ""), entry.get("name", ""))
            index.setdefault(key, []).append(entry)
    return index


def reconcile_playlists(ytm_tracks: list[dict], local_tracks: dict[str, list[dict]]) -> None:
    """Rewrite each local entry's `playlists` to match the LIVE YTM library.

    Keyed by song identity (artist, title) rather than video_id so that a
    YTM re-release (single -> album, new video_id) does NOT wipe the song
    from its playlists. See song_key() — two versions of the same song share
    the same key, so the on-disk entry keeps all live memberships even after
    the id changed.

    If the fetch was incomplete/partial (see fetch_ytm_library.failures),
    we do NOT erase playlists — missing data means "couldn't determine",
    not "confirmed absent" (see architectural concern in the review).
    """
    # song_key(artist, title) -> set of playlist titles it currently belongs to.
    live: dict[str, set[str]] = {}
    for t in ytm_tracks:
        pl = t.get("playlist", "")
        if pl:
            skey = song_key(t.get("artist", ""), t.get("title", ""))
            live.setdefault(skey, set()).add(pl)

    incomplete = bool(getattr(fetch_ytm_library, "failures", [])) or bool(getattr(fetch_ytm_library, "truncated", False))
    if incomplete:
        print("  Note: YTM fetch was incomplete — preserving existing playlists for items not seen (not erasing).")

    for entries in local_tracks.values():
        for entry in entries:
            skey = song_key(entry.get("artist", ""), entry.get("name", ""))
            if incomplete and skey not in live:
                # Couldn't determine — keep what we have instead of wiping to []
                continue
            if incomplete:
                # Additive: keep existing plus live (don't remove on partial)
                existing = set(pl_list(entry))
                entry["playlists"] = sorted(existing | live.get(skey, set()))
            else:
                entry["playlists"] = sorted(live.get(skey, set()))


def fetch_ytm_library(ytm: YTMusic) -> list[dict]:
    """Fetch all tracks from every YTM library playlist.

    Returns a plain list of track dicts. Failures for individual playlists
    are tracked on ``fetch_ytm_library.failures`` and truncation on
    ``fetch_ytm_library.truncated`` so callers doing destructive work can
    tell "confirmed absent" from "couldn't determine". See also the
    architectural note in dedupe/sync about partial data.
    """
    tracks: list[dict] = []
    failures: list[str] = []
    truncated = False
    print("  Fetching library playlists...")
    try:
        playlists = ytm.get_library_playlists(limit=1000)
    except Exception as e:
        print(f"  Failed to fetch library playlists: {e}")
        fetch_ytm_library.failures = ["<library playlists>"]
        fetch_ytm_library.truncated = False
        return []

    if len(playlists) >= 1000:
        print("  Warning: library playlist count hit limit=1000 — results may be truncated (paginate not implemented).")
        truncated = True

    for playlist in playlists:
        playlist_id    = playlist.get("playlistId")
        playlist_title = playlist.get("title", "Unknown Playlist")

        if not playlist_id or playlist_title == "Liked Songs":
            print(f"    Skipping: {playlist_title}")
            continue

        print(f"    Fetching: {playlist_title}")
        try:
            data = ytm.get_playlist(playlist_id, limit=10000)
            yt_tracks = data.get("tracks", [])
            if len(yt_tracks) >= 10000:
                print(f"    Warning: playlist '{playlist_title}' hit limit=10000 — truncated.")
                truncated = True
            for item in yt_tracks:
                video_id = item.get("videoId")
                if video_id:
                    album = item.get("album") or {}
                    tracks.append({
                        "video_id": video_id,
                        "title":    item.get("title", "Unknown"),
                        "artist":   ", ".join(a.get("name", "Unknown") for a in item.get("artists", [])),
                        "album":    album.get("name", ""),
                        "album_id": album.get("id", ""),
                        "playlist": playlist_title,
                    })
        except Exception as e:
            print(f"    Failed to fetch {playlist_title}: {e}")
            failures.append(playlist_title)

    fetch_ytm_library.failures = failures  # type: ignore[attr-defined]
    fetch_ytm_library.truncated = truncated  # type: ignore[attr-defined]
    if failures:
        print(f"  Warning: {len(failures)} playlist(s) failed to fetch — results are partial; destructive actions will be skipped.")
    return tracks

# Initialise attributes for callers that inspect them before first fetch
fetch_ytm_library.failures = []  # type: ignore[attr-defined]
fetch_ytm_library.truncated = False  # type: ignore[attr-defined]


# ---------------------------------------------------------------------------
# Download
# ---------------------------------------------------------------------------

def download_track(video_id: str, title: str, artist: str, album: str,
                   playlist: str, music_dir: Path) -> Path | None:
    """Download a single track via yt-dlp and return the final Path on success."""
    safe_artist = sanitize(artist)
    safe_album  = sanitize(normalize_album(album or "Unknown Album"))
    safe_title  = sanitize(title)

    output_dir = music_dir / safe_artist / safe_album
    output_dir.mkdir(parents=True, exist_ok=True)

    filename_base = f"{safe_artist} - {safe_title}"
    final_path    = output_dir / f"{filename_base}.ogg"
    tmp_base      = output_dir / f"_tmp_{video_id}"
    url           = f"https://music.youtube.com/watch?v={video_id}"

    cmd = [
        "yt-dlp",
        "--embed-thumbnail", "--embed-metadata",
        "--parse-metadata", f":{title}:%(title)s",
        "--extractor-args", "youtube:player-client=web_embedded,web",
        "--js-runtimes", "node",
    ]
    cookie = write_cookie_file()
    if cookie:
        cmd += ["--cookies", str(cookie)]
    cmd += [
        "--metadata", f"title={title}",
        "--metadata", f"artist={artist}",
        "--metadata", f"album={album}",
        "--metadata", f"genre={playlist}",
        "--metadata", f"comment=https://music.youtube.com/watch?v={video_id}",
        "--metadata", f"purl=https://music.youtube.com/watch?v={video_id}",
        "-x", "--audio-format", "opus", "--audio-quality", "0",
        "-w",
        "-o", f"{tmp_base}.%(ext)s",
        url,
    ]

    try:
        result = subprocess.run(cmd, capture_output=not VERBOSE, timeout=300)

        if result.returncode != 0:
            if VERBOSE:
                print(f"    {playlist}: Download failed — {artist} - {title}")
            else:
                stderr = result.stderr.decode()
                if "The downloaded file is empty" in stderr or "Did not get any data blocks" in stderr:
                    print(f"    {playlist}: Rate limited / empty — {artist} - {title}")
                else:
                    print(f"    {playlist}: Download failed — {artist} - {title}: {stderr.strip()}")
            return None

        time.sleep(0.1)

        ogg_path = None
        for ext in (".opus", ".ogg", ".webm"):
            for p in output_dir.glob(f"_tmp_{video_id}{ext}*"):
                if p.stat().st_size > 0:
                    ogg_path = p
                    break
            if ogg_path:
                break

        if not ogg_path:
            print(f"    {playlist}: Could not locate downloaded file — {artist} - {title} (expected _tmp_{video_id}.*)")
            return None

        if ogg_path.stat().st_size < 1_000:
            print(f"    {playlist}: File too small, skipping — {artist} - {title}")
            ogg_path.unlink(missing_ok=True)
            return None

        if ogg_path != final_path:
            print(f"    Renaming: {ogg_path.name} -> {final_path.name}")
            final_path.unlink(missing_ok=True)
            ogg_path.rename(final_path)

        # Clean only leftover temp files for this video_id — never touch
        # unrelated .opus/.webm/.webp in the same album directory.
        for f in output_dir.glob(f"_tmp_{video_id}*"):
            if f.is_file() and f != final_path:
                f.unlink(missing_ok=True)

        print(f"    {playlist}: {artist} - {title}")
        if fix_audio_mime_type(final_path):
            print(f"    Converted video/ogg to audio/ogg: {final_path.name}")
        return final_path

    except Exception as e:
        print(f"    {playlist}: Exception — {artist} - {title}: {e}")
        return None


def fix_audio_mime_type(filepath: Path) -> bool:
    """Convert video/ogg to audio/ogg if needed. Returns True if converted."""
    try:
        result = subprocess.run(
            ["file", "--mime-type", "-b", str(filepath)],
            capture_output=True, text=True, timeout=10,
        )
        mime_type = result.stdout.strip()
        if mime_type != "video/ogg":
            return False

        # Extract cover art (first frame) as JPEG — best effort
        cover_path = filepath.with_suffix(".jpg")
        cov = subprocess.run(
            ["ffmpeg", "-y", "-i", str(filepath), "-vframes", "1", "-update", "1", str(cover_path)],
            capture_output=True, timeout=30,
        )
        if cov.returncode != 0 or not cover_path.exists() or cover_path.stat().st_size < 1000:
            cover_path.unlink(missing_ok=True)

        # Convert to audio-only opus
        fixed_path = filepath.with_stem(filepath.stem + "_fixed")
        res = subprocess.run(
            ["ffmpeg", "-y", "-i", str(filepath), "-vn", "-c:a", "libopus", "-b:a", "256k", str(fixed_path)],
            capture_output=True, timeout=300,
        )
        if res.returncode != 0:
            # ffmpeg failed — don't leave a broken fixed file
            if fixed_path.exists():
                fixed_path.unlink(missing_ok=True)
            cover_path.unlink(missing_ok=True)
            return False

        if fixed_path.exists() and fixed_path.stat().st_size > 1000:
            if cover_path.exists():
                try:
                    import base64
                    from mutagen.oggopus import OggOpus
                    from mutagen.flac import Picture
                    with open(cover_path, "rb") as f:
                        image_data = f.read()
                    audio = OggOpus(str(fixed_path))
                    picture = Picture()
                    picture.data = image_data
                    picture.type = 3
                    picture.mime = "image/jpeg"
                    picture.desc = "front cover"
                    audio["metadata_block_picture"] = [base64.b64encode(picture.write()).decode("ascii")]
                    audio.save()
                except Exception as e:
                    print(f"    Warning: Failed to embed cover art: {e}")

            if filepath.exists():
                filepath.unlink()
            fixed_path.rename(filepath)
            return True

        cover_path.unlink(missing_ok=True)
    except Exception as e:
        print(f"    fix_audio_mime_type exception: {e}")
    return False


def retag_track(filepath: Path, track: dict) -> bool:
    """Update embedded Vorbis/Opus tags on an existing file when YTM re-releases
    a song (new video_id/album). Keeps the on-disk file's comment/purl in sync
    with content.toml so `scan` and future dedupe see the current id.

    Best-effort: returns True if tags were written, False otherwise. Never
    raises — caller should treat failures as non-fatal.
    """
    try:
        ext = filepath.suffix.lower()
        url = f"https://music.youtube.com/watch?v={track.get('video_id', '')}"
        title  = track.get("title", "")
        artist = track.get("artist", "")
        album  = track.get("album", "")

        if ext in (".ogg", ".opus"):
            from mutagen.oggopus import OggOpus
            audio = OggOpus(str(filepath))
            if title:
                audio["title"] = title
            if artist:
                audio["artist"] = artist
            if album:
                audio["album"] = album
            if url and track.get("video_id"):
                audio["comment"] = url
                audio["purl"] = url
            audio.save()
            return True

        if ext == ".m4a":
            from mutagen.mp4 import MP4
            audio = MP4(str(filepath))
            if audio.tags is None:
                audio.add_tags()
            if title:
                audio.tags["\xa9nam"] = title
            if artist:
                audio.tags["\xa9ART"] = artist
            if album:
                audio.tags["\xa9alb"] = album
            if url:
                audio.tags["comment"] = url
                audio.tags["purl"] = url
            audio.save()
            return True

        if ext == ".flac":
            from mutagen.flac import FLAC
            audio = FLAC(str(filepath))
            if title:
                audio["title"] = [title]
            if artist:
                audio["artist"] = [artist]
            if album:
                audio["album"] = [album]
            if url and track.get("video_id"):
                audio["comment"] = [url]
                audio["purl"] = [url]
            audio.save()
            return True

        # Generic fallback via mutagen.File
        import mutagen
        audio = mutagen.File(str(filepath))
        if audio is None:
            return False
        if title:
            audio["title"] = title
        if artist:
            audio["artist"] = artist
        if album:
            audio["album"] = album
        audio.save()
        return True
    except Exception as e:
        print(f"    Warning: retag failed for {filepath.name}: {e}")
        return False


