def sync(playlist_filter: str | list[str] | None = None, config: dict | None = None) -> None:
    """Fetch YTM library and download any missing tracks."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync")
    print("=" * 40)
    print(f"\n  Download path: {music_dir}")

    if not playlist_filter:
        filters = None
    elif isinstance(playlist_filter, str):
        filters = [playlist_filter.lower()]
    else:
        filters = [f.lower() for f in playlist_filter]

    if filters:
        print(f"  Filtering to: {', '.join(filters)}")

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    print("\nLoading local library...")
    local_tracks = get_local_tracks(load_content_toml(music_dir))
    # Deduplicate index entries that point to the same on-disk file.
    # Older sync runs created one entry per (video_id, playlist); the
    # canonical model is one entry per file with a `playlists` array.
    # Merge any duplicate paths so a song in N playlists is stored once.
    _index_dupes = 0
    _seen_paths: dict[str, dict] = {}
    for vid in list(local_tracks.keys()):
        kept: list[dict] = []
        for entry in local_tracks[vid]:
            p = entry.get("path", "")
            if p in _seen_paths:
                _index_dupes += 1
                for pl in pl_list(entry):
                    add_playlist(_seen_paths[p], pl)
                continue
            _seen_paths[p] = entry
            kept.append(entry)
        if len(kept) != len(local_tracks[vid]):
            local_tracks[vid] = kept
            if not kept:
                del local_tracks[vid]
    # Also handle duplicates that crossed video_id boundaries: an entry
    # merged above may have been under a different vid; ensure the survivor
    # stays but the duplicate's vid list no longer contains it. The loop
    # above already covers it because _seen_paths is global.
    if _index_dupes:
        print(f"  Merged {_index_dupes} duplicate index entries (same path, different playlists)")

    song_index = build_song_index(local_tracks)
    print(f"  {len(local_tracks)} tracks in content.toml")

    print("\nFetching YTM library...")
    ytm_tracks = fetch_ytm_library(get_ytmusic_client())

    # Snapshot playlists before reconcile so we can detect whether
    # reconcile/metadata updates actually changed anything and avoid
    # rewriting content.toml every run when the library is already in sync.
    _snap: dict[int, list[str]] = {
        id(e): sorted(pl_list(e))
        for entries in local_tracks.values() for e in entries
    }

    # Reconcile stored playlist membership with the live library so generated
    # .m3u8 files match what YTM actually shows (drops drifted/removed tracks).
    reconcile_playlists(ytm_tracks, local_tracks)

    # Deduplicate by (video_id, playlist) pair — YTM sometimes returns the same track
    # multiple times within a single playlist
    seen: set[tuple[str, str]] = set()
    deduped: list[dict] = []
    for t in ytm_tracks:
        key = (t["video_id"], t.get("playlist", ""))
        if key not in seen:
            seen.add(key)
            deduped.append(t)
    ytm_tracks = deduped

    print(f"  {len(ytm_tracks)} unique tracks in YTM library")

    # ------------------------------------------------------------------
    # Classify live tracks by SONG identity (artist+title), not video_id,
    # so the same song in multiple playlists is handled as ONE unit and
    # re-releases (single -> album, new video_id) are recognised without
    # re-downloading. A song in N playlists -> one on-disk file with N
    # entries in its `playlists` list. This is the "same stuff behind
    # dedupe" now used proactively during sync.
    # ------------------------------------------------------------------
    def _on_disk(entries: list[dict]) -> bool:
        return any(expand_path(e.get("path", ""), music_dir).exists() for e in entries)

    from collections import defaultdict as _dd

    # Group live tracks by song identity. Each key collects every
    # occurrence across playlists. Filtering is applied before grouping
    # so a filtered sync only plans the requested playlists.
    song_to_tracks: dict[str, list[dict]] = _dd(list)
    for track in ytm_tracks:
        pl = track.get("playlist", "")
        if filters and pl.lower() not in filters:
            continue
        skey = song_key(track.get("artist", ""), track.get("title", ""))
        song_to_tracks[skey].append(track)

    # Decide per-song: keep/re-release (in-place) vs download once.
    # to_download holds one representative track per genuinely new song
    # and the full set of playlists that song belongs to.
    to_download: list[dict] = []
    new_song_playlists: dict[str, list[str]] = {}
    # (existing entry, representative live track) for in-place metadata refresh
    to_retag: list[tuple[dict, dict]] = []
    # track how many existing songs gain metadata updates (informational)
    refreshed = 0

    for skey, tracks in song_to_tracks.items():
        existing = song_index.get(skey, [])
        on_disk = [e for e in existing if expand_path(e.get("path", ""), music_dir).exists()]

        if on_disk:
            # Already have this song on disk — keep it, don't download.
            # Use the first on-disk file as canonical (if multiple exist,
            # dedupe handles collapsing them; we just update the one we keep).
            canonical = on_disk[0]
            # Reconcile already merged playlists by song identity; ensure
            # every playlist in this group is present (idempotent).
            for t in tracks:
                add_playlist(canonical, t.get("playlist", ""))

            # If YTM now serves this song under a different video_id or
            # album (re-release), update the stored identity in-place and
            # queue a re-tag so the file's embedded comment/purl stays in
            # sync with content.toml (keeps scan/dedupe correct).
            rep = tracks[0]
            live_vid = rep.get("video_id", "")
            live_album = rep.get("album", "")
            live_album_id = rep.get("album_id", "")
            if (canonical.get("youtube_id") != live_vid
                    or canonical.get("album_id", "") != live_album_id
                    or canonical.get("album", "") != live_album):
                # Only count as a refresh if the id/album actually change;
                # playlist-only changes were already handled above.
                if (canonical.get("youtube_id") != live_vid
                        or canonical.get("album_id", "") != live_album_id):
                    to_retag.append((canonical, rep))
                    refreshed += 1
                canonical["youtube_id"] = live_vid
                if live_album:
                    canonical["album"] = live_album
                if live_album_id is not None:
                    canonical["album_id"] = live_album_id
            continue

        # Genuinely new song — download ONCE regardless of how many
        # playlists contain it. Keep one representative track for yt-dlp
        # (which uses the track's playlist as genre); merge all playlists
        # onto the single entry after download.
        rep = tracks[0]
        to_download.append(rep)
        pls = sorted({t.get("playlist", "") for t in tracks if t.get("playlist", "")})
        new_song_playlists[skey] = pls

    print(f"\n  {len(to_download)} tracks to download")
    if refreshed:
        print(f"  {refreshed} tracks to refresh (re-release metadata update)")

    if not to_download and not to_retag:
        # No new files and no id/album refreshes. Check whether reconcile
        # or the per-song playlist merges (or the index-path dedupe above)
        # actually changed any entry.
        dirty = _index_dupes > 0
        if not dirty:
            for entries in local_tracks.values():
                for e in entries:
                    if sorted(pl_list(e)) != _snap.get(id(e), []):
                        dirty = True
                        break
                if dirty:
                    break
        if dirty:
            write_content_toml(music_dir, local_tracks)
            print("\nGenerating playlists...")
            write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))
            print("\nPlaylists updated.")
        else:
            print("\nLibrary is up to date!")
        return

    downloaded_paths: list[Path] = []
    if to_download:
        print("\nDownloading missing tracks...")
        pad = len(str(len(to_download)))
        for i, track in enumerate(to_download, 1):
            print(f"  [{i:0{pad}d}/{len(to_download)}] ", end="", flush=True)
            # Use the first playlist as genre; the full set is merged after.
            path = download_track(
                track["video_id"], track["title"], track["artist"],
                track.get("album", ""), track.get("playlist", ""),
                music_dir,
            )
            if path:
                downloaded_paths.append(path)
                skey = song_key(track.get("artist", ""), track.get("title", ""))
                vid = track["video_id"]
                # Collapse any stale entries for this video_id (paths gone).
                local_tracks[vid] = [
                    e for e in local_tracks.get(vid, [])
                    if expand_path(e.get("path", ""), music_dir).exists()
                ]
                entry = make_track_entry(track, music_dir)
                # A new song in multiple playlists gets ONE entry with ALL
                # its playlists — this is the core fix for the multi-playlist
                # duplicate that previously produced one entry per playlist.
                for pl in new_song_playlists.get(skey, []):
                    add_playlist(entry, pl)
                local_tracks.setdefault(vid, []).append(entry)
            else:
                print("  (skipped — download failed)")

        print(f"\nDownloaded {len(downloaded_paths)}/{len(to_download)} tracks")

        if downloaded_paths:
            print("\nCropping cover art...")
            for path in downloaded_paths:
                try:
                    crop_cover_art(path)
                except Exception as e:
                    print(f"    Warning: Crop failed for {path.name}: {e}")

    # Re-tag existing files whose id/album changed (re-release).
    if to_retag:
        print(f"\nUpdating metadata for {len(to_retag)} re-released track(s)...")
        for entry, track in to_retag:
            fp = expand_path(entry.get("path", ""), music_dir)
            if fp.exists():
                try:
                    retag_track(fp, track)
                except Exception as e:
                    print(f"    Warning: retag failed for {fp.name}: {e}")

    write_content_toml(music_dir, local_tracks)
    print("\nGenerating playlists...")
    write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))


def scan_library(config: dict | None = None) -> None:
    """Scan existing files on disk and rebuild content.toml from YTM metadata."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Scan")
    print("=" * 40)
    print(f"\n  Scan path: {music_dir}")

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    print("\nFetching YTM library for track IDs...")
    ytm_tracks = fetch_ytm_library(get_ytmusic_client())

    ytm_by_id:   dict[str, dict]       = {}
    ytm_by_name: dict[str, list[dict]] = {}
    for track in ytm_tracks:
        vid = track.get("video_id")
        if vid:
            ytm_by_id[vid] = track
        key = f"{sanitize(track['artist']).lower()} - {sanitize(track['title']).lower()}"
        ytm_by_name.setdefault(key, []).append(track)

    def youtube_id_from_file(filepath: Path) -> str | None:
        try:
            result = subprocess.run(
                ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", str(filepath)],
                capture_output=True, text=True, timeout=10,
            )
            fmt = json.loads(result.stdout).get("format", {})
            comment = fmt.get("comment", "")
            purl = fmt.get("purl", "")

            url = purl or comment

            if "youtube.com/watch" in url:
                return url.split("v=")[-1].split("&")[0]
            if "youtu.be/" in url:
                return url.split("youtu.be/")[-1].split("?")[0]
        except (subprocess.TimeoutExpired, FileNotFoundError,
                json.JSONDecodeError, OSError):
            pass
        return None

    tracks: dict[str, list[dict]] = {}
    for entry in load_content_toml(music_dir).get("tracks", []):
        vid  = entry.get("youtube_id")
        path = entry.get("path", "")
        if vid and path and expand_path(path, music_dir).exists():
            if path not in [e.get("path") for e in tracks.get(vid, [])]:
                tracks.setdefault(vid, []).append(entry)

    known_paths = {e.get("path") for entries in tracks.values() for e in entries}

    for artist_dir in sorted(music_dir.iterdir()):
        if not artist_dir.is_dir() or artist_dir.name.startswith("."):
            continue
        for album_dir in sorted(artist_dir.iterdir()):
            if not album_dir.is_dir() or album_dir.name.startswith("."):
                continue
            for track_file in sorted(album_dir.glob("*.ogg")):
                rp = rel_path(track_file, music_dir)
                if rp in known_paths:
                    continue

                vid = youtube_id_from_file(track_file)
                stem = track_file.stem
                artist, title = stem.split(" - ", 1) if " - " in stem else ("Unknown", stem)

                match = None
                if vid and vid in ytm_by_id:
                    cand = ytm_by_id[vid]
                    # Only trust the YTM match if it actually describes THIS file
                    # (same artist + title). YTM can report a different track
                    # under a recycled id, which previously corrupted metadata.
                    if (sanitize(cand.get("artist", "")).lower() == sanitize(artist).lower()
                            and sanitize(cand.get("title", "")).lower() == sanitize(title).lower()):
                        match = cand

                if not match:
                    # Unknown or mismatched id: register the file from its OWN
                    # on-disk identity (folder = album, stem = artist/title).
                    # Do NOT fall back to name-matching another track's metadata
                    # — that is what previously wrote the wrong album/artist onto
                    # files (e.g. AURORA's album onto Bastille's "Pompeii").
                    vid = vid or f"local-{rp}"
                    entry = {
                        "youtube_id": vid,
                        "path":       rp,
                        "name":       title,
                        "artist":     artist,
                        "album":      album_dir.name,
                        "album_id":   "",
                        "playlists":  [],
                    }
                    existing = next((e for e in tracks.get(vid, [])
                                    if e.get("path") == rp), None)
                    if existing is None:
                        tracks.setdefault(vid, []).append(entry)
                    known_paths.add(rp)
                    continue

                pl_name = match.get("playlist", "")
                entry = {
                    "youtube_id": match["video_id"],
                    "path":       rp,
                    "name":       title,
                    "artist":     artist,
                    "album":      album_dir.name,
                    "album_id":   match.get("album_id", ""),
                    "playlists":  [pl_name] if pl_name else [],
                }
                existing = next((e for e in tracks.get(match["video_id"], [])
                                if e.get("path") == rp), None)
                if existing is None:
                    tracks.setdefault(match["video_id"], []).append(entry)
                else:
                    add_playlist(existing, pl_name)
                known_paths.add(rp)

    count = sum(len(v) for v in tracks.values())
    print(f"\n  Found {count} tracks")
    if count:
        write_content_toml(music_dir, tracks)
    else:
        print("  No tracks found.")


