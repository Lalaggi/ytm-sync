# Download
# ---------------------------------------------------------------------------

def download_track(video_id: str, title: str, artist: str, album: str,
                   playlist: str, music_dir: Path) -> Path | None:
    """Download a single track via yt-dlp and return the final Path on success."""
    safe_artist = sanitize(artist)
    safe_album  = sanitize(album or "Unknown Album")
    safe_title  = sanitize(title)

    output_dir = music_dir / safe_artist / safe_album
    output_dir.mkdir(parents=True, exist_ok=True)

    filename_base = f"{safe_artist} - {safe_title}"
    final_path    = output_dir / f"{filename_base}.ogg"
    tmp_base      = output_dir / f"_tmp_{video_id}"
    url           = f"https://music.youtube.com/watch?v={video_id}"

    cmd = [
        "yt-dlp",
        "--embed-thumbnail", "--embed-metadata",
        "--parse-metadata", f":{title}:%(title)s",
        "--metadata", f"title={title}",
        "--metadata", f"artist={artist}",
        "--metadata", f"album={album}",
        "--metadata", f"genre={playlist}",
        "--metadata", f"comment=https://music.youtube.com/watch?v={video_id}",
        "--metadata", f"purl=https://music.youtube.com/watch?v={video_id}",
        "-x", "--audio-format", "opus", "--audio-quality", "0",
        "-w",
        "-o", f"{tmp_base}.%(ext)s",
        url,
    ]

    try:
        result = subprocess.run(cmd, capture_output=True, timeout=300)

        if result.returncode != 0:
            stderr = result.stderr.decode()
            if "The downloaded file is empty" in stderr or "Did not get any data blocks" in stderr:
                print(f"    {playlist}: Rate limited / empty — {artist} - {title}")
            else:
                print(f"    {playlist}: Download failed — {artist} - {title}: {stderr.strip()}")
            return None

        time.sleep(0.1)

        ogg_path = None
        for ext in (".opus", ".ogg", ".webm"):
            for p in output_dir.glob(f"_tmp_{video_id}{ext}*"):
                if p.stat().st_size > 0:
                    ogg_path = p
                    break
            if ogg_path:
                break

        if not ogg_path:
            now = time.time()
            for ext in (".opus", ".ogg", ".webm"):
                for p in output_dir.glob(f"*{ext}"):
                    if p.stat().st_size > 10_000 and (now - p.stat().st_mtime) < 120:
                        ogg_path = p
                        break
                if ogg_path:
                    break

        if not ogg_path:
            print(f"    {playlist}: Could not locate downloaded file — {artist} - {title}")
            return None

        if ogg_path.stat().st_size < 1_000:
            print(f"    {playlist}: File too small, skipping — {artist} - {title}")
            ogg_path.unlink(missing_ok=True)
            return None

        if ogg_path != final_path:
            print(f"    Renaming: {ogg_path.name} -> {final_path.name}")
            final_path.unlink(missing_ok=True)
            ogg_path.rename(final_path)

        for f in output_dir.glob(f"_tmp_{video_id}*"):
            if f.is_file() and f != final_path:
                f.unlink(missing_ok=True)
        for f in output_dir.glob("*"):
            if f.is_file() and f != final_path and f.suffix in (".webm", ".opus", ".tmp", ".webp"):
                f.unlink(missing_ok=True)

        print(f"    {playlist}: {artist} - {title}")
        return final_path

    except Exception as e:
        print(f"    {playlist}: Exception — {artist} - {title}: {e}")
        return None


# ---------------------------------------------------------------------------
# Cover art
# ---------------------------------------------------------------------------

def crop_cover_art(filepath: Path) -> bool:
    """Crop embedded cover art to a 1:1 square. Returns True if the file was modified."""
    try:
        from PIL import Image
        import io
    except ImportError:
        return False

    ext = filepath.suffix.lower()

    try:
        if ext in (".ogg", ".opus"):
            import base64
            import mutagen
            from mutagen.flac import Picture

            audio = mutagen.File(str(filepath))
            if audio is None:
                return False

            pictures = audio.get("metadata_block_picture", [])
            new_pics, changed = [], False
            for b64 in pictures:
                pic = Picture(base64.b64decode(b64))
                if pic.type == 3:
                    img  = Image.open(io.BytesIO(pic.data))
                    w, h = img.size
                    if w != h:
                        size = min(w, h)
                        left = (w - size) // 2
                        top  = (h - size) // 2
                        out  = io.BytesIO()
                        img.crop((left, top, left + size, top + size)).save(out, format="PNG")
                        pic.data = out.getvalue()
                        changed  = True
                new_pics.append(base64.b64encode(pic.write()).decode("ascii"))
            if changed:
                audio["metadata_block_picture"] = new_pics
                audio.save()
            return changed

        elif ext == ".m4a":
            from mutagen.mp4 import MP4, MP4Cover
            audio  = MP4(str(filepath))
            covers = audio.tags.get("covr", [])
            if not covers:
                return False

            new_covers, changed = [], False
            for cover in covers:
                img  = Image.open(io.BytesIO(bytes(cover)))
                w, h = img.size
                if w == h:
                    new_covers.append(cover)
                    continue
                size = min(w, h)
                left = (w - size) // 2
                top  = (h - size) // 2
                out  = io.BytesIO()
                fmt  = "PNG" if cover.imageformat == MP4Cover.FORMAT_PNG else "JPEG"
                img.crop((left, top, left + size, top + size)).save(out, format=fmt)
                new_fmt = MP4Cover.FORMAT_PNG if fmt == "PNG" else MP4Cover.FORMAT_JPEG
                new_covers.append(MP4Cover(out.getvalue(), imageformat=new_fmt))
                changed = True

            if changed:
                audio.tags["covr"] = new_covers
                audio.save()
            return changed

        elif ext == ".flac":
            from mutagen.flac import FLAC
            audio, changed = FLAC(str(filepath)), False
            for pic in audio.pictures:
                if pic.type != 3:
                    continue
                img  = Image.open(io.BytesIO(pic.data))
                w, h = img.size
                if w == h:
                    continue
                size = min(w, h)
                left = (w - size) // 2
                top  = (h - size) // 2
                out  = io.BytesIO()
                img.crop((left, top, left + size, top + size)).save(out, format="JPEG")
                pic.data = out.getvalue()
                changed  = True
            if changed:
                audio.save()
            return changed

    except Exception:
        pass

    return False


