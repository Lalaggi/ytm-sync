# Dedupe / audit
# ---------------------------------------------------------------------------

def dedupe_library(apply: bool = False, config: dict | None = None) -> None:
    """Collapse genuine duplicate copies of a song to a single canonical file.

    Two situations produce redundant copies:

    1. Index corruption — content.toml lists the same on-disk file more than
       once. Harmless to the files; we just de-duplicate the index.
    2. YTM re-release drift — YTM repoints a playlist entry at a re-released
       version of a song (new video_id + album name) while the old version is
       still around. If your library currently lists only ONE of the two
       video_ids, the other is a stale copy and safe to remove. If BOTH are
       still listed we keep both (they are both legitimately in your library).

    This command is deliberately conservative: it NEVER deletes a file unless
    another on-disk file of the *same song* (same artist/title) is being kept.
    Dry-run by default; pass --apply to actually remove files and rewrite
    content.toml + playlists.
    """
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Dedupe")
    print("=" * 40)
    print(f"\n  Music path: {music_dir}")

    content = load_content_toml(music_dir)
    tracks = content.get("tracks", [])

    # De-duplicate the index itself: one entry per song (path). A song in
    # several playlists is stored ONCE with a `playlists` list, so any repeat
    # of the same path is a true duplicate — merge its playlist memberships
    # into the kept entry and drop the redundant copy.
    seen_paths: dict[str, dict] = {}
    clean_tracks: list[dict] = []
    index_dupes = 0
    for entry in tracks:
        p = entry.get("path", "")
        if p in seen_paths:
            index_dupes += 1
            existing = seen_paths[p]
            for pl in pl_list(entry):
                add_playlist(existing, pl)
            continue
        seen_paths[p] = entry
        clean_tracks.append(entry)

    # Cluster on-disk files by (artist, title). Two different albums/releases
    # of the SAME song share this key; genuinely different songs do not.
    clusters: dict[str, list[dict]] = {}
    for entry in clean_tracks:
        path = expand_path(entry.get("path", ""), music_dir)
        if not path.exists():
            continue
        key = f"{sanitize(entry.get('artist', '')).lower()} - {sanitize(entry.get('name', '')).lower()}"
        clusters.setdefault(key, []).append(entry)

    # Fetch the current YTM library ONCE to learn which video_ids are live.
    live_ids = _current_ytm_ids()

    redundant: list[dict] = []
    for key, entries in sorted(clusters.items()):
        # A cluster is only a duplicate if it has MORE THAN ONE distinct file.
        distinct_paths = {expand_path(e.get("path", ""), music_dir) for e in entries}
        if len(distinct_paths) < 2:
            continue

        # If every video_id in the cluster is still live in YTM, they are all
        # legitimately in your library -> keep all, do not delete.
        ids = {e.get("youtube_id", "") for e in entries}
        if ids and ids.issubset(live_ids):
            continue

        # Otherwise, keep the file whose video_id is live (prefer that); if none
        # are live, keep the newest on disk. Mark the rest for removal.
        keep = next((e for e in entries if e.get("youtube_id") in live_ids), None)
        if keep is None:
            keep = max(entries, key=lambda e: expand_path(e.get("path", ""), music_dir).stat().st_mtime)
        redundant.extend(e for e in entries if e is not keep)

    if index_dupes:
        print(f"\n  Index: {index_dupes} duplicate content.toml entries (same path) will be dropped.")
    if not redundant:
        if index_dupes:
            print("  Only index cleanup needed (no files to remove).")
            if not apply:
                print("  Dry run — re-run with --apply to rewrite the index.")
                return
            write_content_toml(music_dir, get_local_tracks({"tracks": clean_tracks}))
            write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))
            print("  Index rewritten.")
        else:
            print("\n  No redundant copies found. Library is clean!")
        return

    print(f"\n  {len(redundant)} redundant file(s) across "
          f"{sum(1 for k, v in clusters.items() if len({expand_path(e.get('path', ''), music_dir) for e in v}) >= 2)} song(s):")
    for e in redundant:
        print(f"    REMOVE  {e.get('path')}  ({e.get('youtube_id')})")

    if not apply:
        print("\n  Dry run — no files changed. Re-run with --apply to remove.")
        return

    for e in redundant:
        path = expand_path(e.get("path", ""), music_dir)
        try:
            if path.exists():
                path.unlink()
                print(f"    deleted {path}")
        except OSError as exc:
            print(f"    FAILED {path}: {exc}")

    # Rebuild the index from what's left on disk + the de-duplicated entries.
    survivors = [e for e in clean_tracks if expand_path(e.get("path", ""), music_dir).exists()]
    write_content_toml(music_dir, get_local_tracks({"tracks": survivors}))
    print("\nGenerating playlists...")
    write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))


def _current_ytm_ids() -> set[str]:
    """Return the set of video_ids currently in the YTM library (best effort)."""
    try:
        if validate_auth():
            ids = {t["video_id"] for t in fetch_ytm_library(get_ytmusic_client())}
            if ids:
                return ids
    except Exception as e:
        print(f"  Warning: Could not fetch YTM IDs: {e}")
    return set()


def fix_covers(config: dict | None = None) -> None:
    """Crop cover art to 1:1 for all tracks in the library."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Fix Covers")
    print("=" * 40)
    print(f"\n  Music path: {music_dir}")

    tracks = load_content_toml(music_dir).get("tracks", [])
    print(f"  Processing {len(tracks)} tracks...")

    cropped = skipped = errors = 0
    for track in tracks:
        path = track.get("path", "")
        if not path:
            continue
        fp = expand_path(path, music_dir)
        if not fp.exists():
            skipped += 1
            continue
        try:
            if crop_cover_art(fp):
                cropped += 1
                print(f"    Cropped: {fp.name}")
            else:
                skipped += 1
        except Exception as e:
            errors += 1
            print(f"    Error: {fp.name}: {e}")

    print(f"\n  Cropped: {cropped}  Skipped: {skipped}  Errors: {errors}")


def fix_playlists(config: dict | None = None) -> None:
    """Regenerate all .m3u8 playlist files from content.toml."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Fix Playlists")
    print("=" * 40)
    print(f"\n  Music path: {music_dir}")

    content_file = music_dir / "content.toml"
    if not content_file.exists():
        print("\n  No content.toml found. Run 'scan' first.")
        return

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    tracks = load_content_toml(music_dir).get("tracks", [])
    # Reconcile stored playlist membership with the live YTM library so the
    # regenerated .m3u8 files match what YTM actually shows.
    local_tracks = get_local_tracks({"tracks": tracks})
    reconcile_playlists(fetch_ytm_library(get_ytmusic_client()), local_tracks)
    write_content_toml(music_dir, local_tracks)
    write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))


def fix_metadata(config: dict | None = None) -> None:
    """Rewrite embedded metadata tags for all tracks from content.toml."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Fix Metadata")
    print("=" * 40)
    print(f"\n  Music path: {music_dir}")

    tracks = load_content_toml(music_dir).get("tracks", [])
    print(f"  Processing {len(tracks)} tracks...")

    fixed = skipped = errors = 0
    for track in tracks:
        path = track.get("path", "")
        if not path or not track.get("name"):
            skipped += 1
            continue
        fp = expand_path(path, music_dir)
        if not fp.exists():
            skipped += 1
            continue
        try:
            from mutagen.mp4 import MP4
            audio = MP4(str(fp))
            if audio.tags is None:
                audio.add_tags()
            audio.tags["\xa9nam"] = track["name"]
            audio.tags["\xa9ART"] = track.get("artist", "")
            audio.tags["\xa9alb"] = track.get("album", "")
            audio.tags["\xa9gen"] = ", ".join(pl_list(track))
            audio.save()
            fixed += 1
            print(f"    Fixed: {fp.name}")
        except Exception as e:
            errors += 1
            print(f"    Error: {fp.name}: {e}")

    print(f"\n  Fixed: {fixed}  Skipped: {skipped}  Errors: {errors}")


def get_track(query: str, config: dict | None = None) -> None:
    """Search YTM for a track, prompt for selection, and download it."""
    if config is None:
        config = load_config()
    music_dir = get_music_dir(config)

    print("YTM-Sync Get")
    print("=" * 40)

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    local_tracks = get_local_tracks(load_content_toml(music_dir))

    ytm = get_ytmusic_client()
    print(f"\n  Searching: {query}")
    results = ytm.search(query, "songs", limit=10)

    if not results:
        print("  No results found.")
        return

    print()
    for i, r in enumerate(results, 1):
        artists = ", ".join(a.get("name", "Unknown") for a in r.get("artists", []))
        album   = (r.get("album") or {}).get("name", "")
        line    = f"  {i:2}. {artists} - {r.get('title', 'Unknown')}"
        if album:
            line += f"  [{album}]"
        print(line)

    print("\n  Enter number(s) to download (e.g. 1,2,3 or 1-3, or q to quit): ", end="")
    choice = input().strip()
    if choice.lower() == "q":
        print("  Cancelled.")
        return

    indices = []
    for part in re.split(r'[,\s]+', choice):
        if not part:
            continue
        if '-' in part:
            try:
                a, b = part.split('-', 1)
                lo, hi = int(a), int(b)
                if lo > hi:
                    lo, hi = hi, lo
                if not (1 <= lo <= len(results) and 1 <= hi <= len(results)):
                    print(f"  Invalid range: {part}")
                    return
                indices.extend(range(lo, hi + 1))
            except ValueError:
                print(f"  Invalid choice: {part}")
                return
        else:
            try:
                n = int(part)
                if not 1 <= n <= len(results):
                    print(f"  Invalid choice: {n}")
                    return
                indices.append(n)
            except ValueError:
                print(f"  Invalid choice: {part}")
                return

    if not indices:
        print("  No valid selections.")
        return

    seen = set()
    ordered = []
    for n in reversed(indices):
        if n not in seen:
            seen.add(n)
            ordered.append(n)
    ordered.reverse()
    last_sel = ordered[-1]

    last_path = None
    downloaded_any = False
    for sel in sorted(set(indices)):
        idx = sel - 1
        r        = results[idx]
        video_id = r.get("videoId")
        if not video_id:
            print(f"\n  [{sel}] No video ID found.")
            continue

        title   = r.get("title", "Unknown")
        artists = ", ".join(a.get("name", "Unknown") for a in r.get("artists", []))
        album   = (r.get("album") or {}).get("name", "")

        safe_artists = sanitize(artists)
        safe_album   = sanitize(normalize_album(album or "Unknown Album"))
        safe_title   = sanitize(title)
        output_dir   = music_dir / safe_artists / safe_album
        output_dir.mkdir(parents=True, exist_ok=True)

        filename_base = f"{safe_artists} - {safe_title}"
        url           = f"https://music.youtube.com/watch?v={video_id}"

        print(f"\n  [{sel}] Downloading: {artists} - {title}")
        tmp_base = output_dir / f"_tmp_get_{video_id}"
        cmd = [
            "yt-dlp", "--embed-thumbnail", "--embed-metadata",
            "--parse-metadata", f":{title}:%(title)s",
            "--extractor-args", "youtube:player-client=web_embedded,web",
            "--js-runtimes", "node",
        ]
        cookie = write_cookie_file()
        if cookie:
            cmd += ["--cookies", str(cookie)]
        cmd += [
            "--metadata", f"title={title}",
            "--metadata", f"artist={artists}",
            "--metadata", f"album={album}",
            "--metadata", f"comment=https://music.youtube.com/watch?v={video_id}",
            "--metadata", f"purl=https://music.youtube.com/watch?v={video_id}",
            "-x", "--audio-format", "opus", "--audio-quality", "0",
            "-w",
            "-o", f"{tmp_base}.%(ext)s",
            url,
        ]
        result = subprocess.run(cmd, capture_output=not VERBOSE, timeout=300)
        if result.returncode != 0:
            msg = "" if VERBOSE else f": {result.stderr.decode().strip()}"
            print(f"  [{sel}] Download failed{msg}")
            continue

        ogg_path = None
        for ext in (".opus", ".ogg", ".webm"):
            for p in output_dir.glob(f"_tmp_get_{video_id}{ext}*"):
                if p.stat().st_size > 0:
                    ogg_path = p
                    break
            if ogg_path:
                break
        if not ogg_path:
            for ext in (".opus", ".ogg", ".webm"):
                for p in output_dir.glob(f"_tmp_get_*{ext}*"):
                    if p.stat().st_size > 10_000:
                        ogg_path = p
                        break
                if ogg_path:
                    break

        if not ogg_path:
            print(f"  [{sel}] Failed to find downloaded file.")
            continue

        final_path = output_dir / f"{filename_base}.ogg"
        if ogg_path.suffix != ".ogg":
            r2 = subprocess.run(
                ["ffmpeg", "-y", "-i", str(ogg_path), "-c:a", "libopus", "-b:a", "256k",
                 str(final_path)],
                capture_output=True, timeout=300,
            )
            if final_path.exists() and final_path.stat().st_size > 10_000:
                ogg_path.unlink()
                ogg_path = final_path
            else:
                print(f"  [{sel}] Failed to convert file.")
                continue

        if ogg_path != final_path:
            ogg_path.rename(final_path)

        for f in output_dir.glob(f"{filename_base}.*"):
            if f != final_path:
                f.unlink(missing_ok=True)
        for f in output_dir.glob("_tmp_get_*"):
            if f.is_file() and f != final_path:
                f.unlink(missing_ok=True)

        if fix_audio_mime_type(final_path):
            print(f"  [{sel}] Converted video/ogg to audio/ogg")

        print(f"  [{sel}] Saved: {final_path}")

        print(f"  [{sel}] Cropping cover art...")
        try:
            crop_cover_art(final_path)
        except Exception as e:
            print(f"  [{sel}] Warning: Crop failed: {e}")

        local_tracks.setdefault(video_id, []).append(make_track_entry({
            "video_id": video_id,
            "title":    title,
            "artist":   artists,
            "album":    album,
            "playlist": "__GET__",
        }, music_dir))
        downloaded_any = True

        if sel == last_sel:
            last_path = final_path

    if downloaded_any:
        write_content_toml(music_dir, local_tracks)
        print("\nGenerating playlists...")
        write_playlists(music_dir, load_content_toml(music_dir).get("tracks", []))

    if last_path:
        subprocess.run(["xdg-open", str(last_path)])


def list_library() -> None:
    """Print playlist names and track counts from the YTM library."""
    print("YTM-Sync Library")
    print("=" * 40)

    if not validate_auth():
        print("\nAuthentication required. Run 'ytm-sync setup' first.")
        sys.exit(1)

    ytm = get_ytmusic_client()

    liked = ytm.get_liked_songs(limit=10_000)
    print(f"\nLiked Songs: {len(liked.get('tracks', []))} tracks")

    print("\nLibrary Playlists:")
    playlists = ytm.get_library_playlists(limit=1000)
    for playlist in playlists:
        title = playlist.get("title", "Unknown")
        pid   = playlist.get("playlistId", "")
        try:
            count = ytm.get_playlist(pid, limit=1).get("trackCount", "?")
        except Exception:
            count = "?"
        print(f"  {title}: {count} tracks")

    print(f"\nTotal: {len(playlists)} playlists")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _config_from_args(args) -> dict | None:
    return {"download_path": args.path} if getattr(args, "path", None) else None


def main() -> None:
    parser = argparse.ArgumentParser(description="YTM-Sync: Sync YouTube Music to local files")
    parser.add_argument("-v", "--verbose", action="store_true", help="Show yt-dlp progress and full error output")
    sub    = parser.add_subparsers(dest="command", required=True)

    p_setup = sub.add_parser("setup",    help="Set up authentication and download path")
    p_setup.add_argument("-p", "--path", help="Download path (default: ~/Music)")

    p_sync = sub.add_parser("sync",     help="Sync library (download missing tracks)")
    p_sync.add_argument("playlist", nargs="*", help="Limit sync to specific playlist(s)")
    p_sync.add_argument("-p", "--path", help="Download path override")

    sub.add_parser("validate",           help="Validate authentication")
    sub.add_parser("list",               help="List playlists and track counts")

    for name, help_str in [
        ("scan",           "Scan existing files and rebuild content.toml"),
        ("fix-playlists",  "Regenerate .m3u8 playlist files"),
        ("fix-covers",     "Crop embedded cover art to 1:1"),
        ("fix-metadata",   "Rewrite embedded tags from content.toml"),
    ]:
        sub.add_parser(name, help=help_str).add_argument("-p", "--path", help="Music directory override")

    p_dedupe = sub.add_parser("dedupe", help="Collapse songs YTM serves under multiple releases")
    p_dedupe.add_argument("--apply", action="store_true", help="Actually remove redundant copies")
    p_dedupe.add_argument("-p", "--path", help="Music directory override")

    p_get = sub.add_parser("get",        help="Search and download a single track")
    p_get.add_argument("query", nargs="+", help="Search query")
    p_get.add_argument("-p", "--path",   help="Output directory override")

    try:
        args   = parser.parse_args()
        global VERBOSE
        VERBOSE = args.verbose
        config = _config_from_args(args)

        match args.command:
            case "setup":         setup_auth(args.path); sys.exit(0)
            case "validate":
                print(f"  Download path: {get_music_dir(config or load_config())}")
                sys.exit(0 if validate_auth() else 1)
            case "list":          list_library()
            case "sync":          sync(args.playlist or None, config)
            case "scan":          scan_library(config)
            case "fix-playlists": fix_playlists(config)
            case "fix-covers":    fix_covers(config)
            case "fix-metadata":  fix_metadata(config)
            case "dedupe":         dedupe_library(args.apply, config)
            case "get":           get_track(" ".join(args.query), config)

    except KeyboardInterrupt:
        print("\nExiting...")
        sys.exit(130)


if __name__ == "__main__":
    main()
